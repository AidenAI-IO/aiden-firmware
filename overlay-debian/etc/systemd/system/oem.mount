[Unit]
Description=Active Aiden OEM slot
DefaultDependencies=no
Requires=aiden-slot-resolve.service
After=aiden-slot-resolve.service aiden-rootfs-grow.service
Before=local-fs.target

[Mount]
What=/run/aiden/oem-device
Where=/oem
Type=ext4
Options=noatime
TimeoutSec=20s

[Install]
WantedBy=local-fs.target
