[Unit]
Description=Provision persistent Aiden SSH host identity
Requires=aiden-userdata-migrate.service aiden-root-home.service
After=aiden-userdata-migrate.service aiden-root-home.service
Before=ssh.service

[Service]
Type=oneshot
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStart=/usr/lib/aiden/aiden-ssh-identity
RemainAfterExit=yes
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
