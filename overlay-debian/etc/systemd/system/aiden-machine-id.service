[Unit]
Description=Provision the persistent Aiden machine identity across A/B rootfs slots
Requires=userdata.mount userdata-ota.mount aiden-userdata-migrate.service
After=userdata.mount userdata-ota.mount aiden-userdata-migrate.service
After=systemd-machine-id-commit.service
Before=aiden-environment.service aiden-ota-health-marker.service aiden.target
ConditionPathExists=/usr/lib/aiden/ota

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-machine-id-provision
RemainAfterExit=yes
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
