[Unit]
Description=Check and install Aiden firmware and business package updates
Requires=userdata-ota.mount aiden-environment.service
Wants=aiden-ota-health.service
After=userdata-ota.mount aiden-environment.service aiden-ota-health.service
ConditionPathExists=/userdata/ota/hybrid-update.pending

[Service]
Type=oneshot
EnvironmentFile=/run/aiden/system.env
ExecStart=/usr/lib/aiden/aiden-managed-env-run /usr/lib/aiden/aiden-hybrid-update
TimeoutStartSec=infinity
UMask=0077
StandardOutput=append:/userdata/ota/config_web_ota_update.log
StandardError=append:/userdata/ota/config_web_ota_update.log

[Install]
WantedBy=multi-user.target
