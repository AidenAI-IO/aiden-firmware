[Unit]
Description=Watch Aiden proxy environment changes
# Disabling implicit paths.target ordering lets this watcher start after the
# initial proxy environment exists without creating an early-boot cycle.
DefaultDependencies=no
After=aiden-wifi-proxy.service
Before=shutdown.target
Conflicts=shutdown.target

[Path]
PathChanged=/run/wifi_proxy/proxy-env
Unit=aiden-wifi-proxy-agent-restart.service

[Install]
WantedBy=aiden.target
