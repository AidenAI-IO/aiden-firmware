[Unit]
Description=Activate the validated Aiden userdata swapfile
Requires=aiden-userdata-migrate.service
After=aiden-userdata-migrate.service aiden-zram.service

[Service]
Type=oneshot
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/etc/aiden_swap.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_SWAP
ExecStart=/usr/lib/aiden/aiden-swap start
ExecStop=/usr/lib/aiden/aiden-swap stop
RemainAfterExit=yes
TimeoutStartSec=180s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
