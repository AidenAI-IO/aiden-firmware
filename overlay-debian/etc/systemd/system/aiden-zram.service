[Unit]
Description=Configure bounded Aiden zram swap
After=systemd-modules-load.service

[Service]
Type=oneshot
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_ZRAM
ExecStart=/usr/lib/aiden/aiden-zram start
ExecStop=/usr/lib/aiden/aiden-zram stop
RemainAfterExit=yes
TimeoutStartSec=15s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
