[Unit]
Description=Load the Luckfox AIC8800 Wi-Fi driver and firmware
Requires=aiden-userdata-migrate.service
After=systemd-udevd.service aiden-userdata-migrate.service
Before=wpa_supplicant@wlan0.service

[Service]
Type=oneshot
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_WIFIDRV
ExecStartPre=/usr/lib/aiden/aiden-wifi-log-retention
ExecStart=/usr/lib/aiden/aiden-wifi-driver
StandardOutput=append:/var/log/wifi_driver/wifi_driver.log
StandardError=append:/var/log/wifi_driver/wifi_driver.log
RemainAfterExit=yes
TimeoutStartSec=35s

[Install]
WantedBy=multi-user.target
