[Unit]
Description=Recover interrupted Aiden data restore transactions
Requires=userdata.mount userdata-ota.mount
After=userdata.mount userdata-ota.mount
Before=aiden-userdata-migrate.service aiden-root-home.service aiden-bluetooth-state.service
Before=aiden-machine-id.service aiden-config-web.service aiden-agent.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-backup-recover
RemainAfterExit=yes
TimeoutStartSec=300s

[Install]
WantedBy=multi-user.target
