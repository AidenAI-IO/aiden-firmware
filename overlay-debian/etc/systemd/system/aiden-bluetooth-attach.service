[Unit]
Description=Attach the Aiden AIC8800 Bluetooth UART
Requires=aiden-wifi-driver.service
After=aiden-wifi-driver.service dev-ttyS1.device
Wants=dev-ttyS1.device
Before=bluetooth.service
ConditionPathExists=/dev/ttyS1
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_BLUETOOTH_HCI
ExecStartPre=/usr/lib/aiden/aiden-bluetooth-prepare
ExecStart=/usr/bin/hciattach -n -s 1500000 /dev/ttyS1 any 1500000 flow nosleep
ExecStartPost=/usr/lib/aiden/aiden-bluetooth-hci-wait
Restart=on-failure
RestartSec=2s
TimeoutStartSec=25s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
