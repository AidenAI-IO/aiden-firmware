[Unit]
Description=Bind persistent Aiden BlueZ state
Requires=aiden-userdata-migrate.service
After=aiden-userdata-migrate.service
Before=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-bluetooth-state
RemainAfterExit=yes
TimeoutStartSec=10s

[Install]
WantedBy=multi-user.target
