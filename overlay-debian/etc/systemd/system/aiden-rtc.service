[Unit]
Description=Calibrate an invalid RTC without blocking offline startup
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-timesyncd.service time-set.target
ConditionPathExists=/dev/rtc0

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-rtc
TimeoutStartSec=10s

[Install]
WantedBy=sysinit.target
