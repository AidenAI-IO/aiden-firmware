[Unit]
Description=Aiden local configuration and recovery portal
Requires=oem.mount aiden-userdata-migrate.service aiden-environment.service
Wants=aiden-agent.service aiden-usb-dnsmasq.service
After=oem.mount aiden-userdata-migrate.service aiden-environment.service
After=aiden-agent.service aiden-usb-dnsmasq.service
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/oem/usr/bin/config_web

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/run/aiden/system.env
Environment=AIDEN_AGENT_INIT_SCRIPT=/usr/lib/aiden/aiden-agent-control
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_CONFIG_WEB
ExecStart=/oem/usr/bin/config_web --bind=0.0.0.0 --port=80 --config=/userdata/agent/agent.toml --wifi-config=/userdata/debian/wifi/wpa_supplicant-wlan0.conf --wifi-iface=wlan0 --wifi-backend=systemd-networkd --system-env=/userdata/system/env --web-root=/oem/usr/share/aiden/config-web
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
