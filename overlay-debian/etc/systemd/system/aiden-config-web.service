[Unit]
Description=Aiden local configuration and recovery portal
Requires=aiden-userdata-migrate.service aiden-environment.service
Wants=aiden-usb-dnsmasq.service aiden-wifi-proxy.service
After=aiden-userdata-migrate.service aiden-environment.service
After=aiden-wifi-proxy.service aiden-usb-dnsmasq.service
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/usr/lib/aiden/agent

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/run/aiden/system.env
Environment=AIDEN_AGENT_INIT_SCRIPT=/usr/lib/aiden/aiden-agent-control
Environment=AIDEN_FRAME_SERVICE_INIT_SCRIPT=/usr/lib/aiden/aiden-frame-control
Environment=AIDEN_WIFI_PROXY_INIT_SCRIPT=/usr/lib/aiden/aiden-wifi-proxy-control
Environment=AIDEN_ENV_RUN_BIN=/usr/lib/aiden/aiden-managed-env-run
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_CONFIG_WEB
ExecStart=/usr/lib/aiden/aiden-managed-env-run /usr/lib/aiden/agent config-web --bind=0.0.0.0 --port=80 --config=/userdata/agent/agent.toml --wifi-config=/userdata/debian/wifi/wpa_supplicant-wlan0.conf --wifi-config-environment=/run/aiden/wpa_supplicant-config.env --wifi-interface=wlan0 --wifi-backend=systemd-networkd --system-env=/userdata/system/env --web-root=/usr/share/aiden/config-web
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
