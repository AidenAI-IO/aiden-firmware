[Unit]
Description=Recover stalled Aiden USB ECM sessions
Requires=aiden-usb-gadget.service aiden-usb-dnsmasq.service
After=aiden-usb-gadget.service aiden-usb-dnsmasq.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/lib/aiden/aiden-usb-ecm-watchdog
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
