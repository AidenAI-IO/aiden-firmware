[Unit]
Description=Aiden BLE peripheral and ANCS service
Requires=aiden-environment.service bluetooth.service
After=aiden-environment.service bluetooth.service
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/usr/lib/aiden/ble_service

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/etc/aiden_ble_service.conf
EnvironmentFile=/run/aiden/system.env
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_BLE_SERVICE
RuntimeDirectory=ble_service
LogsDirectory=ble_service
ExecStart=/usr/lib/aiden/ble_service --socket ${SOCKET_PATH} --device-name ${DEVICE_NAME} --event-capacity ${EVENT_CAPACITY} --pairing-window ${PAIRING_WINDOW_SECONDS}s
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s
StandardOutput=append:/var/log/ble_service/ble_service.log
StandardError=append:/var/log/ble_service/ble_service.log

[Install]
WantedBy=multi-user.target
