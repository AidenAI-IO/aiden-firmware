[Unit]
Description=Aiden per-network loopback proxy
Requires=oem.mount aiden-userdata-migrate.service aiden-environment.service
Wants=aiden-wifi-driver.service network.target
After=oem.mount aiden-userdata-migrate.service aiden-environment.service
After=aiden-wifi-driver.service network.target
Before=aiden-agent.service aiden-config-web.service
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/oem/usr/bin/agent

[Service]
Type=simple
EnvironmentFile=/run/aiden/system.env
RuntimeDirectory=wifi_proxy
LogsDirectory=wifi_proxy
ExecStart=/oem/usr/bin/agent wifi-proxy --listen=127.0.0.1:18080 --config=/userdata/system/wifi-proxies.json --environment=/run/wifi_proxy/proxy-env --wifi-interface=wlan0
ExecStartPost=/usr/lib/aiden/aiden-wifi-proxy-wait /run/wifi_proxy/proxy-env
Restart=on-failure
RestartSec=2s
TimeoutStartSec=10s
TimeoutStopSec=10s
StandardOutput=append:/var/log/wifi_proxy/wifi_proxy.log
StandardError=append:/var/log/wifi_proxy/wifi_proxy.log

[Install]
WantedBy=multi-user.target
