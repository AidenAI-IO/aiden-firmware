[Unit]
Description=Aggregate local health before committing an Aiden OTA slot
Requires=oem.mount userdata.mount userdata-ota.mount
Requires=aiden-userdata-migrate.service aiden-environment.service
Wants=systemd-networkd.service aiden-wifi-driver.service aiden-wlan-guard.service
Wants=bluetooth.service aiden-usb-gadget.service aiden-usb-dnsmasq.service
Wants=aiden-frame.service aiden-audio.service aiden-ble.service
Wants=aiden-agent.service aiden-config-web.service
After=oem.mount userdata.mount userdata-ota.mount
After=aiden-userdata-migrate.service aiden-environment.service systemd-networkd.service
After=aiden-wifi-driver.service aiden-wlan-guard.service bluetooth.service
After=aiden-usb-gadget.service aiden-usb-dnsmasq.service
After=aiden-frame.service aiden-audio.service aiden-ble.service
After=aiden-agent.service aiden-config-web.service
Before=aiden-ota-health.service
ConditionPathExists=/userdata/ota/pending_boot.json
ConditionPathExists=/oem/usr/bin/ota

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-ota-health-aggregate
TimeoutStartSec=60s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
