[Unit]
Description=Serve local-only DHCP on the Aiden usb0 gadget
Requires=aiden-usb-gadget.service
After=aiden-usb-gadget.service systemd-networkd.service
Before=aiden-config-web.service aiden-usb-ecm-watchdog.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_USB_DHCP
ExecStartPre=/usr/lib/aiden/aiden-wait-interface-ip usb0
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/dnsmasq.d/usb0.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/usb0.conf --pid-file=/run/aiden/dnsmasq-usb0.pid
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
