[Unit]
Description=Aiden device agent
Requires=oem.mount aiden-userdata-migrate.service aiden-environment.service aiden-boot-timeline-init.service
Wants=aiden-frame.service aiden-audio.service aiden-ble.service
After=oem.mount aiden-userdata-migrate.service aiden-environment.service aiden-boot-timeline-init.service
After=aiden-frame.service aiden-audio.service aiden-ble.service time-set.target
StartLimitIntervalSec=120s
StartLimitBurst=5
ConditionPathExists=/oem/usr/bin/agent

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/run/aiden/system.env
Environment=AIDEN_BLE_SERVICE_SOCKET=/run/ble_service/ble_service.sock
Environment=AIDEN_USB_COMPOSITE_REFRESH_COMMAND=/usr/lib/aiden/aiden-usb-ecm-watchdog
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_AGENT
RuntimeDirectory=agent
ExecStartPre=/usr/bin/install -d -m 0755 /userdata/agent /userdata/agent/log
ExecStart=/oem/usr/bin/agent -dir /userdata/agent -addr 0.0.0.0:8080
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=15s
StandardOutput=append:/userdata/agent/log/agent.log
StandardError=append:/userdata/agent/log/agent.log

[Install]
WantedBy=multi-user.target
