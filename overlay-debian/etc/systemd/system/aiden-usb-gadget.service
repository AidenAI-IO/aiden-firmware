[Unit]
Description=Create the Aiden HID and ECM USB gadget
Requires=aiden-userdata-migrate.service
After=aiden-userdata-migrate.service systemd-modules-load.service
Before=aiden-usb-dnsmasq.service aiden-config-web.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_USB_HID
ExecStart=/usr/lib/aiden/aiden-usb-gadget start
ExecStop=/usr/lib/aiden/aiden-usb-gadget stop
RemainAfterExit=yes
TimeoutStartSec=60s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
