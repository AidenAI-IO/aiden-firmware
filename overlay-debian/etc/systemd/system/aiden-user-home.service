[Unit]
Description=Bind the persistent Aiden user home directory
Requires=aiden-userdata-migrate.service
After=aiden-userdata-migrate.service
Before=aiden-ssh-identity.service ssh.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-user-home
RemainAfterExit=yes
TimeoutStartSec=10s

[Install]
WantedBy=multi-user.target
