[Unit]
Description=Aiden ttyd browser terminal
Requires=oem.mount aiden-environment.service aiden-usb-gadget.service
After=oem.mount aiden-environment.service aiden-usb-gadget.service
ConditionPathExists=/oem/usr/bin/ttyd
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/run/aiden/system.env
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_TTYD
ExecStart=/usr/lib/aiden/aiden-ttyd-start
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
LogsDirectory=ttyd
StandardOutput=append:/var/log/ttyd/ttyd.log
StandardError=append:/var/log/ttyd/ttyd.log

[Install]
WantedBy=multi-user.target
