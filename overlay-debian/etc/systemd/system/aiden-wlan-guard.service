[Unit]
Description=Bounded Aiden Wi-Fi recovery guard
Requires=aiden-wifi-driver.service wpa_supplicant@wlan0.service
After=aiden-wifi-driver.service wpa_supplicant@wlan0.service systemd-networkd.service
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_WLAN_GUARD
ExecStart=/usr/lib/aiden/aiden-wlan-guard
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
