[Unit]
Description=Aiden frame capture service
Requires=oem.mount aiden-environment.service aiden-media-modules.service
After=oem.mount aiden-environment.service aiden-media-modules.service
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/oem/usr/bin/frame_service

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/etc/aiden_frame_service.conf
EnvironmentFile=/run/aiden/system.env
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_FRAME_SERVICE
RuntimeDirectory=frame_service
LogsDirectory=frame_service
ExecStart=/usr/lib/aiden/aiden-frame-start
Restart=on-failure
RestartSec=2s
TimeoutStartSec=35s
TimeoutStopSec=10s
StandardOutput=append:/var/log/frame_service/frame_service.log
StandardError=append:/var/log/frame_service/frame_service.log

[Install]
WantedBy=multi-user.target
