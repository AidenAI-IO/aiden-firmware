[Unit]
Description=Generate the strict Aiden service environment
Requires=aiden-userdata-migrate.service aiden-machine-id.service
After=aiden-userdata-migrate.service aiden-machine-id.service aiden-platform-ldconfig.service
Before=aiden-adb-host.service aiden-agent.service aiden-audio.service
Before=aiden-ble.service aiden-config-web.service aiden-frame.service
Before=aiden-ota-health-marker.service aiden-ota-health.service aiden-ttyd.service
ConditionPathExists=/usr/lib/aiden/aiden-environment

[Service]
Type=oneshot
ExecStartPre=/usr/bin/install -d -m 0755 /run/aiden
ExecStart=/usr/lib/aiden/aiden-environment --input=/userdata/system/env --output=/run/aiden/system.env --invalid-marker=/run/aiden/environment.invalid
RemainAfterExit=yes
TimeoutStartSec=10s

[Install]
WantedBy=multi-user.target
