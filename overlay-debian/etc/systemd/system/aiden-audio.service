[Unit]
Description=Aiden audio capture and playback service
Requires=oem.mount aiden-environment.service aiden-media-modules.service
After=oem.mount aiden-environment.service aiden-media-modules.service sound.target
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/oem/usr/bin/audio_service

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/etc/aiden_audio_service.conf
EnvironmentFile=/run/aiden/system.env
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_AUDIO_SERVICE
RuntimeDirectory=audio_service
LogsDirectory=audio_service
ExecStartPre=/usr/bin/install -d -m 0755 /userdata/audio_service
ExecStart=/oem/usr/bin/audio_service --socket ${SOCKET_PATH} --volume-state ${VOLUME_STATE_PATH}
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s
StandardOutput=append:/var/log/audio_service/audio_service.log
StandardError=append:/var/log/audio_service/audio_service.log

[Install]
WantedBy=multi-user.target
