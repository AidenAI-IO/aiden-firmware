[Unit]
Description=Bind the persistent Aiden root home
Requires=aiden-userdata-migrate.service
After=aiden-userdata-migrate.service
Before=aiden-ssh-identity.service ssh.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-root-home
RemainAfterExit=yes
TimeoutStartSec=10s

[Install]
WantedBy=multi-user.target
