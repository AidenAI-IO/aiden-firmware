[Unit]
Description=Resolve the active Aiden A/B slot
DefaultDependencies=no
After=systemd-udevd.service systemd-remount-fs.service
Wants=systemd-udev-settle.service
Before=aiden-rootfs-grow.service oem.mount userdata.mount userdata-ota.mount local-fs-pre.target

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-slot-resolve
RemainAfterExit=yes
TimeoutStartSec=30s

[Install]
WantedBy=local-fs-pre.target
