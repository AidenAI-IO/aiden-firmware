[Unit]
Description=Recover protected Aiden configuration before userdata consumers start
Requires=oem.mount userdata.mount userdata-ota.mount aiden-oem-ldconfig.service
After=oem.mount userdata.mount userdata-ota.mount aiden-oem-ldconfig.service
Before=aiden-userdata-migrate.service

[Service]
Type=oneshot
# Recovery restores the environment input; do not load that input before it runs.
ExecStart=/usr/lib/aiden/ota --config /userdata/debian/ota/config.json recover
RemainAfterExit=yes
TimeoutStartSec=60s
LogsDirectory=ota
StandardOutput=append:/var/log/ota/ota-recovery.log
StandardError=append:/var/log/ota/ota-recovery.log

[Install]
WantedBy=multi-user.target
