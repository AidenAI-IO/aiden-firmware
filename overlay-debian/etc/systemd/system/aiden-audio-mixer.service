[Unit]
Description=Initialize RV1106 microphone controls
Requires=aiden-media-modules.service
After=aiden-media-modules.service sound.target
Before=aiden-audio.service
PartOf=aiden-audio.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-audio-mixer
RemainAfterExit=yes
TimeoutStartSec=30s
