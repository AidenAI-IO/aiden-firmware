[Unit]
Description=Capture and archive the Aiden systemd boot timeline
Wants=aiden.target
Requires=aiden-boot-timeline-init.service
After=aiden.target aiden-boot-timeline-init.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-boot-timeline finalize-systemd
RemainAfterExit=yes
TimeoutStartSec=15s

[Install]
WantedBy=multi-user.target
