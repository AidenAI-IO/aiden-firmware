[Unit]
Description=Migrate persistent Aiden userdata for Debian 13
Requires=userdata.mount userdata-ota.mount
After=userdata.mount userdata-ota.mount
Before=aiden-root-home.service aiden-ssh-identity.service aiden-environment.service
Before=wpa_supplicant@wlan0.service ssh.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aiden/aiden-userdata-migrate
RemainAfterExit=yes
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
