# sshd runs this as the login user after allocating SSH_TTY. Its stdin carries
# X11 cookies, so the helper opens SSH_TTY instead of using stdin.
if [ -n "${SSH_TTY:-}" ] && [ -n "${XDG_SESSION_ID:-}" ]; then
    /usr/lib/aiden/aiden-ssh-session-tty || :
fi

# An sshrc replaces sshd's built-in xauth setup; preserve that behavior for
# installations that enable X11 forwarding and install xauth.
if [ -n "${DISPLAY:-}" ] && [ -x /usr/bin/xauth ]; then
    if read -r proto cookie; then
        case "$DISPLAY" in
            localhost:*) display="unix:${DISPLAY#localhost:}" ;;
            *) display=$DISPLAY ;;
        esac
        printf 'remove %s\nadd %s %s %s\n' "$display" "$display" "$proto" "$cookie" \
            | /usr/bin/xauth -q -
    fi
fi
