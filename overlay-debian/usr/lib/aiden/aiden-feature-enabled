#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: aiden-feature-enabled VARIABLE" >&2
    exit 2
fi

case "$1" in
    ENABLE_AGENT|ENABLE_AUDIO_SERVICE|ENABLE_BLE_SERVICE|ENABLE_CONFIG_WEB|\
    ENABLE_FRAME_SERVICE|ENABLE_SWAP|ENABLE_USB_DHCP|ENABLE_USB_HID|\
    ENABLE_WETTY|ENABLE_WIFIDRV|ENABLE_WLAN_GUARD|ENABLE_BLUETOOTH_HCI|\
    ENABLE_ZRAM) ;;
    *)
        echo "Unsupported Aiden feature switch: $1" >&2
        exit 2
        ;;
esac

value=$(printenv "$1" 2>/dev/null || true)
if [ "${value}" = 1 ]; then
    exit 0
fi
echo "$1 is disabled"
exit 1
