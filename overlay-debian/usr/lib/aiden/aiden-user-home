#!/bin/sh
set -eu

# Bind mount persistent user home directory from userdata
source_home=/userdata/home
target_home=/home

# Ensure userdata is mounted
findmnt -nr --target /userdata >/dev/null

# Create source and target directories
mkdir -p "${source_home}" "${target_home}"
chmod 0755 "${source_home}"

# If /home is not already a mount point or not mounted from userdata, bind mount it
if ! findmnt -nr -o TARGET --target "${target_home}" \
    | awk -v target="${target_home}" '$1 == target {found=1} END {exit !found}'; then
    # The factory rootfs ships /home/aiden, and a device upgraded from a
    # release without this service holds any home created since. Seed those
    # into userdata first so the bind mount does not hide them. Reading
    # ${target_home} here is safe because it is still the rootfs directory.
    if [ -z "$(ls -A "${source_home}")" ] && [ -n "$(ls -A "${target_home}")" ]; then
        cp -a "${target_home}/." "${source_home}/"
    fi
    mount --bind "${source_home}" "${target_home}"
fi
