#!/bin/sh
set -u

if [ -n "${AIDEN_AMIXER_BIN:-}" ]; then
    amixer_bin=${AIDEN_AMIXER_BIN}
else
    amixer_bin=$(command -v amixer 2>/dev/null || true)
fi

if [ -z "${amixer_bin}" ] || [ ! -x "${amixer_bin}" ]; then
    echo "aiden-audio-mixer: amixer is not available" >&2
    exit 1
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=10 >/dev/null 2>&1 || true
fi

# The codec controls are created asynchronously after snd-soc-rv1106 loads.
ready=0
attempt=0
while [ "${attempt}" -lt 40 ]; do
    if "${amixer_bin}" controls >/dev/null 2>&1; then
        ready=1
        break
    fi
    attempt=$((attempt + 1))
    sleep 0.25
done
if [ "${ready}" -ne 1 ]; then
    echo "aiden-audio-mixer: ALSA controls did not become ready" >&2
    exit 1
fi

set_control() {
    value=$1
    shift
    for name in "$@"; do
        if "${amixer_bin}" -q set "${name}" "${value}" >/dev/null 2>&1; then
            return 0
        fi
    done
    echo "aiden-audio-mixer: failed to set $* to ${value}" >&2
    return 1
}

status=0
# These settings were previously applied by the Buildroot S60micinit script.
set_control 3 'ADC MIC Left Gain' || status=1
set_control 3 'ADC MIC Right Gain' || status=1
set_control VREFx0_975 'ADC MICBIAS Voltage' || status=1
set_control SingadcL 'ADC Mode' || status=1
# Older kernels expose the ALC controls without the Volume suffix.
set_control 26 'ADC ALC Left' 'ADC ALC Left Volume' || status=1
set_control 26 'ADC ALC Right' 'ADC ALC Right Volume' || status=1

if [ "${status}" -ne 0 ]; then
    exit 1
fi

echo "aiden-audio-mixer: microphone controls initialized" >&2
