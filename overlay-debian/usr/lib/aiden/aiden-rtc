#!/bin/sh
set -eu

default_date=${RTC_DEFAULT_DATE:-2026-06-09}
command -v hwclock >/dev/null 2>&1 || exit 0
rtc_time=$(hwclock 2>/dev/null || true)
case "${rtc_time}" in
    *1969*|*1970*)
        current=$(date +%Y%m%d)
        baseline=$(printf '%s' "${default_date}" | tr -d '-')
        if [ "${current}" -lt "${baseline}" ]; then
            date -s "${default_date}" >/dev/null
        fi
        hwclock -w
        ;;
esac
