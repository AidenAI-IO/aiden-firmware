#!/bin/sh
set -eu

cmdline_path=${AIDEN_CMDLINE_PATH:-/proc/cmdline}
run_dir=${AIDEN_RUN_DIR:-/run/aiden}
wait_seconds=${AIDEN_SLOT_WAIT_SECONDS:-20}

case "${wait_seconds}" in
    ''|*[!0-9]*|0) echo "Invalid slot device wait: ${wait_seconds}" >&2; exit 1 ;;
esac
[ -r "${cmdline_path}" ] || { echo "Cannot read ${cmdline_path}" >&2; exit 1; }

suffix=
root_suffix=
for argument in $(cat "${cmdline_path}"); do
    case "${argument}" in
        aiden.slot_suffix=*) suffix=${argument#aiden.slot_suffix=} ;;
        root=PARTLABEL=rootfs_a|root=*/rootfs_a|root=/dev/mmcblk0p9) root_suffix=_a ;;
        root=PARTLABEL=rootfs_b|root=*/rootfs_b|root=/dev/mmcblk0p10) root_suffix=_b ;;
    esac
done

case "${suffix}" in
    _a|_b) ;;
    '') echo "Missing aiden.slot_suffix in ${cmdline_path}" >&2; exit 1 ;;
    *) echo "Invalid aiden.slot_suffix=${suffix}" >&2; exit 1 ;;
esac
if [ -n "${root_suffix}" ] && [ "${root_suffix}" != "${suffix}" ]; then
    echo "Root slot ${root_suffix} disagrees with aiden.slot_suffix=${suffix}" >&2
    exit 1
fi

mkdir -p "${run_dir}"
mkdir -p /dev/disk/by-partlabel

# Some Rockchip kernels expose the partition table as mmcblk0pN but do not
# run udev rules that create /dev/disk/by-partlabel links. Keep the label
# paths as the stable interface used by systemd and the OTA agent.
partition_node() {
    name=$1
    label_path=/dev/disk/by-partlabel/${name}
    if [ -b "${label_path}" ]; then
        printf '%s\n' "${label_path}"
        return 0
    fi

    case "${name}" in
        misc) number=4 ;;
        boot_a) number=5 ;;
        boot_b) number=6 ;;
        oem_a) number=7 ;;
        oem_b) number=8 ;;
        rootfs_a) number=9 ;;
        rootfs_b) number=10 ;;
        userdata) number=11 ;;
        ota) number=12 ;;
        *) return 1 ;;
    esac

    candidate=/dev/mmcblk0p${number}
    [ -b "${candidate}" ] || return 1
    ln -sfn "${candidate}" "${label_path}"
    printf '%s\n' "${label_path}"
}

for name in "rootfs${suffix}" "oem${suffix}" userdata ota; do
    path=/dev/disk/by-partlabel/${name}
    elapsed=0
    while ! partition_node "${name}" >/dev/null 2>&1 && [ "${elapsed}" -lt "${wait_seconds}" ]; do
        udevadm settle --timeout=1 >/dev/null 2>&1 || true
        sleep 1
        elapsed=$((elapsed + 1))
    done
    partition_node "${name}" >/dev/null || {
        echo "Slot device is unavailable: ${path}" >&2
        exit 1
    }
done

# Populate every partition label used by the OTA writer as well as the
# active-slot mounts. At this point the kernel partition nodes are known to
# exist because the mandatory active-slot loop has completed.
for name in misc boot_a boot_b oem_a oem_b rootfs_a rootfs_b; do
    partition_node "${name}" >/dev/null 2>&1 || true
done

# The OTA writer also accesses misc directly. Create the same compatibility
# link when the board exposes only numbered mmcblk0 partitions.
partition_node misc >/dev/null 2>&1 || true

ln -sfn "/dev/disk/by-partlabel/oem${suffix}" "${run_dir}/oem-device"
ln -sfn "/dev/disk/by-partlabel/rootfs${suffix}" "${run_dir}/rootfs-device"
tmp=${run_dir}/slot.env.tmp.$$
{
    printf 'AIDEN_SLOT_SUFFIX=%s\n' "${suffix}"
    printf 'AIDEN_SLOT=%s\n' "${suffix#_}"
} >"${tmp}"
chmod 0644 "${tmp}"
mv "${tmp}" "${run_dir}/slot.env"
