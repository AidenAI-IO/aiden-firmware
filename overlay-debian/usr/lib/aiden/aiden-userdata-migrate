#!/bin/sh
set -eu

schema=1
state_dir=/userdata/system/migration
state_file=${state_dir}/debian13.json
backup_root=${state_dir}/backups
debian_dir=/userdata/debian
wifi_dir=${debian_dir}/wifi
wifi_target=${wifi_dir}/wpa_supplicant-wlan0.conf

findmnt -nr --target /userdata >/dev/null || {
    echo "/userdata is not a mounted filesystem" >&2
    exit 1
}

# Services may open their persistent stdout before ExecStartPre runs. Create
# the agent log parent while userdata ordering is already guaranteed.
mkdir -p /userdata/agent/log
chmod 0755 /userdata/agent /userdata/agent/log

if [ -r "${state_file}" ] && grep -q '"schema_version"[[:space:]]*:[[:space:]]*1' "${state_file}"; then
    exit 0
fi

transaction=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || date -u +%Y%m%dT%H%M%SZ)
case "${transaction}" in *[!A-Za-z0-9._-]*) echo "Invalid migration transaction id" >&2; exit 1 ;; esac
backup_dir=${backup_root}/${transaction}
mkdir -p "${state_dir}" "${backup_dir}" "${wifi_dir}" \
    "${debian_dir}/ota" /userdata/system/ssh /userdata/userhome/.ssh
chmod 0700 /userdata/system/ssh /userdata/userhome/.ssh

backup_path() {
    source=$1
    [ -e "${source}" ] || return 0
    relative=${source#/userdata/}
    destination=${backup_dir}/${relative}
    mkdir -p "$(dirname "${destination}")"
    cp -a "${source}" "${destination}"
}

for source in \
    /userdata/wpa_supplicant.conf \
    /userdata/system/env \
    /userdata/agent/agent.toml \
    /userdata/ota/config.json \
    /userdata/ota/state.json; do
    backup_path "${source}"
done

if [ ! -s "${wifi_target}" ]; then
    if [ -s /userdata/wpa_supplicant.conf ]; then
        wifi_tmp=${wifi_target}.tmp.$$
        cp -p /userdata/wpa_supplicant.conf "${wifi_tmp}"
    else
        wifi_tmp=${wifi_target}.tmp.$$
        {
            echo 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev'
            echo 'update_config=1'
            echo 'country=CN'
        } >"${wifi_tmp}"
    fi
    chmod 0600 "${wifi_tmp}"
    validate_dir=/run/aiden/wpa-validate-$$
    mkdir -p "${validate_dir}"
    set +e
    timeout --signal=TERM --kill-after=1s 1s \
        /usr/sbin/wpa_supplicant -D wired -i lo -C "${validate_dir}" \
        -c "${wifi_tmp}" >/dev/null 2>&1
    validation_status=$?
    set -e
    rm -rf "${validate_dir}"
    case "${validation_status}" in
        0|124|143) ;;
        *)
            rm -f "${wifi_tmp}"
            echo "Legacy Wi-Fi configuration failed wpa_supplicant validation" >&2
            exit 1
            ;;
    esac
    mv "${wifi_tmp}" "${wifi_target}"
fi
chmod 0600 "${wifi_target}"

for legacy_dir in /userdata/userhome/.ssh/host /userdata/ssh/host; do
    [ -d "${legacy_dir}" ] || continue
    for legacy_key in "${legacy_dir}"/ssh_host_*; do
        [ -s "${legacy_key}" ] || continue
        target=/userdata/system/ssh/$(basename "${legacy_key}")
        [ -s "${target}" ] || cp -p "${legacy_key}" "${target}"
    done
done
chmod 0600 /userdata/system/ssh/ssh_host_*_key 2>/dev/null || true
chmod 0644 /userdata/system/ssh/ssh_host_*_key.pub \
    /userdata/system/ssh/ssh_host_*_key-cert.pub 2>/dev/null || true

if [ ! -s /userdata/system/machine-id ] && [ -r /etc/machine-id ]; then
    machine_id=$(tr -d '\r\n' </etc/machine-id)
    if printf '%s\n' "${machine_id}" | grep -Eq '^[0-9a-f]{32}$'; then
        printf '%s\n' "${machine_id}" >/userdata/system/machine-id.tmp.$$
        chmod 0444 /userdata/system/machine-id.tmp.$$
        mv /userdata/system/machine-id.tmp.$$ /userdata/system/machine-id
    fi
fi

state_tmp=${state_file}.tmp.$$
cat >"${state_tmp}" <<EOF
{"schema_version":${schema},"transaction_id":"${transaction}","status":"complete"}
EOF
chmod 0600 "${state_tmp}"
sync -f "${state_tmp}"
mv "${state_tmp}" "${state_file}"
sync -f "${state_dir}"
