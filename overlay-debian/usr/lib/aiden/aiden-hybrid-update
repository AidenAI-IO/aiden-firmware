#!/usr/bin/env python3
"""Check signed OTA/APT sources and install available updates, OTA first."""

import fcntl
from contextlib import contextmanager
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from datetime import datetime, timezone


def path_setting(name, default):
    return Path(os.environ.get(name, default))


MARKER = path_setting("AIDEN_HYBRID_UPDATE_MARKER", "/userdata/ota/hybrid-update.pending")
LOCK = path_setting("AIDEN_CONFIG_WEB_OTA_UPDATE_LOCK", "/tmp/config_web_ota_update.lock")
STATE = path_setting("AIDEN_OTA_STATE_PATH", "/userdata/ota/state.json")
BOOT_ID = path_setting("AIDEN_BOOT_ID_PATH", "/proc/sys/kernel/random/boot_id")
OTA = os.environ.get("AIDEN_OTA_BIN", "/usr/lib/aiden/ota")
CONFIG = os.environ.get("AIDEN_OTA_CONFIG", "/userdata/debian/ota/config.json")
APT = os.environ.get("AIDEN_APT_GET_BIN", "apt-get")
BUSINESS_SOURCE = os.environ.get("AIDEN_BUSINESS_APT_SOURCE", "/etc/apt/sources.list.d/aiden-business.sources")
MAINTENANCE_LOCK = path_setting("AIDEN_MAINTENANCE_LOCK", "/run/aiden/backup.lock")


def log(message, level="INFO"):
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    print(f'{timestamp} [{level}][config_web][ota] message={json.dumps(message)}', flush=True)


def save_marker(document):
    with tempfile.NamedTemporaryFile(mode="w", dir=MARKER.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            json.dump(document, stream)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(temporary, MARKER)
            sync_marker_directory()
        finally:
            temporary.unlink(missing_ok=True)


def sync_marker_directory():
    fd = os.open(MARKER.parent, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def run(command, capture=False):
    env = dict(os.environ, LC_ALL="C", DEBIAN_FRONTEND="noninteractive")
    result = subprocess.run(command, env=env, text=True, check=True,
                            stdout=subprocess.PIPE if capture else sys.stdout)
    return result.stdout or ""


def ota(command, *args):
    # OTA diagnostics go to stderr; stdout is the CLI's JSON contract.
    return json.loads(run([OTA, "--config", CONFIG, command, *args], capture=True))


@contextmanager
def exclusive_lock(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"Another maintenance operation holds {path}") from error
        yield


def ota_lock_path():
    config = json.loads(Path(CONFIG).read_text())
    return Path(config.get("update_lock_path") or STATE.parent / "update.lock")


def package_updates():
    log("hybrid: package-check")
    # A cached apt-cache candidate can miss a newly published package. Refresh
    # authenticated metadata first; a failed source must not look up to date.
    if not Path(BUSINESS_SOURCE).is_file():
        raise RuntimeError("Aiden business APT source is missing")
    run([APT, "-o", "APT::Update::Error-Mode=any",
         "-o", f"Dir::Etc::sourcelist={BUSINESS_SOURCE}",
         "-o", "Dir::Etc::sourceparts=-", "-o", "APT::Get::List-Cleanup=0", "update"])
    plan = run([APT, "--simulate", "--only-upgrade", "install", "aiden-business"], capture=True)
    print(plan, end="", flush=True)
    packages = [line.split()[1].split(":")[0] for line in plan.splitlines() if line.startswith("Inst ")]
    if any(package != "aiden-business" for package in packages) or any(line.startswith("Remv ") for line in plan.splitlines()):
        raise RuntimeError("Business update would change other packages; a firmware OTA is required")
    return "aiden-business" in packages


def install_packages():
    if not package_updates():
        log("hybrid: up-to-date")
        return
    log("hybrid: package-install")
    run([APT, "-y", "--only-upgrade", "--no-remove", "-o", "Dpkg::Options::=--force-confdef",
         "-o", "Dpkg::Options::=--force-confold", "install", "aiden-business"])
    log("hybrid: completed")


def update(marker):
    if marker["phase"] == "post-ota":
        state = json.loads(STATE.read_text())
        if marker["boot_id"] == BOOT_ID.read_text().strip():
            if state.get("phase") == "pending-reboot":
                log("hybrid: waiting-reboot")
                return False
            raise RuntimeError("OTA interrupted before reboot; retry the update")
        if (state.get("phase") != "committed" or
                state.get("current_version") != marker["version"] or
                state.get("current_build_time") != marker["build_time"]):
            raise RuntimeError("OTA did not commit the requested firmware (rollback or failed health); package upgrade skipped")
        log("hybrid: ota-committed")
    elif marker["phase"] == "requested":
        log("hybrid: ota-check")
        available = ota("check")
        if type(available.get("available")) is not bool:
            raise RuntimeError("Invalid OTA check response")
        if available["available"]:
            marker = {"phase": "post-ota", "boot_id": BOOT_ID.read_text().strip(),
                      "version": available["version"], "build_time": available["build_time"]}
            # Persist before ota update: it can reboot before returning JSON.
            save_marker(marker)
            log("hybrid: ota-install")
            result = ota("update", "--expected-version", marker["version"],
                         "--expected-build-time", marker["build_time"])
            if result.get("Updated") is True:
                log("hybrid: waiting-reboot")
                return False
            if result.get("NoUpdate") is not True:
                raise RuntimeError("Invalid OTA update response")
    else:
        raise RuntimeError("Unknown hybrid update phase")
    # A direct CLI OTA must not race dpkg writes to the active rootfs.
    with exclusive_lock(ota_lock_path()):
        if (STATE.parent / "pending_boot.json").exists():
            raise RuntimeError("OTA is awaiting boot health confirmation; package upgrade skipped")
        save_marker({"phase": "packages"})
        install_packages()
    return True


def main():
    if sys.argv[1:]:
        raise RuntimeError("Usage: aiden-hybrid-update")
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a") as lock:
        # Config Web holds this lock while publishing the request and queuing
        # systemd. Wait for it to release; a second worker sees no marker.
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not MARKER.exists():
            return 0
        try:
            marker = json.loads(MARKER.read_text())
            if marker["phase"] == "packages":
                # Power loss during dpkg requires explicit recovery, not an
                # automatic apt invocation on every boot.
                raise RuntimeError("Package upgrade was interrupted; check dpkg status before retrying")
            with exclusive_lock(MAINTENANCE_LOCK):
                if not update(marker):
                    return 0
            code = 0
        except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
            log(str(error), "ERROR")
            code = 1
        MARKER.unlink(missing_ok=True)
        sync_marker_directory()
        timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"{timestamp} [config_web][ota] update_exited exit_code={code}", flush=True)
        return code


if __name__ == "__main__":
    sys.exit(main())
