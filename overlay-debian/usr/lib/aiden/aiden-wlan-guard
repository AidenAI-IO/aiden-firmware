#!/bin/sh
set -eu

interface=${WLAN_GUARD_IFACE:-wlan0}
interval=${WLAN_GUARD_INTERVAL:-10}
threshold=${WLAN_GUARD_FAIL_THRESHOLD:-5}
cooldown=${WLAN_GUARD_RECOVER_COOLDOWN:-20}
max_recoveries=${WLAN_GUARD_MAX_RECOVERIES:-3}
healthy_threshold=${WLAN_GUARD_HEALTHY_THRESHOLD:-6}
for value in "${interval}" "${threshold}" "${cooldown}" "${max_recoveries}" "${healthy_threshold}"; do
    case "${value}" in ''|*[!0-9]*|0) exit 1 ;; esac
done

gateway() {
    ip route show default dev "${interface}" 2>/dev/null \
        | awk '$1 == "default" && $2 == "via" {print $3; exit}'
}
associated() {
    [ "$(wpa_cli -i "${interface}" status 2>/dev/null | sed -n 's/^wpa_state=//p')" = COMPLETED ]
}
reachable() {
    host=$(gateway)
    [ -n "${host}" ] || return 1
    ping -c 2 -W 1 -I "${interface}" "${host}" >/dev/null 2>&1 && return 0
    # Some gateways filter ICMP. A fresh ARP reply still proves the local
    # link is alive; an old neighbour-cache entry does not.
    arping -q -f -c 2 -w 3 -I "${interface}" "${host}" >/dev/null 2>&1
}
recover() {
    logger -t aiden-wlan-guard "reassociating ${interface}"
    wpa_cli -i "${interface}" reassociate >/dev/null 2>&1 || true
    sleep 8
    reachable && return 0
    logger -t aiden-wlan-guard "cycling ${interface} through systemd network control"
    ip link set dev "${interface}" down || true
    sleep 2
    ip link set dev "${interface}" up || true
    systemctl restart "wpa_supplicant@${interface}.service"
    networkctl reconfigure "${interface}" || true
    sleep 8
}

failures=0
recoveries=0
healthy=0
exhausted=0
while :; do
    if ! associated || [ -z "$(gateway)" ]; then
        failures=0
        healthy=0
    elif reachable; then
        failures=0
        if [ "${recoveries}" -gt 0 ]; then
            healthy=$((healthy + 1))
            if [ "${healthy}" -ge "${healthy_threshold}" ]; then
                logger -t aiden-wlan-guard "${interface} stable; recovery budget reset"
                recoveries=0
                exhausted=0
                healthy=0
            fi
        fi
        address=$(ip -4 -o address show dev "${interface}" scope global \
            | awk '{sub(/\/.*/, "", $4); print $4; exit}')
        [ -z "${address}" ] || arping -q -U -c 1 -I "${interface}" "${address}" || true
    else
        healthy=0
        if [ "${recoveries}" -ge "${max_recoveries}" ]; then
            if [ "${exhausted}" -eq 0 ]; then
                logger -t aiden-wlan-guard "recovery limit reached (${max_recoveries}); monitoring ${interface} without further resets"
                exhausted=1
            fi
            sleep "${interval}"
            continue
        fi
        failures=$((failures + 1))
        logger -t aiden-wlan-guard "gateway unreachable (${failures}/${threshold})"
        if [ "${failures}" -ge "${threshold}" ]; then
            recoveries=$((recoveries + 1))
            recover || true
            failures=0
            sleep "${cooldown}"
        fi
    fi
    sleep "${interval}"
done
