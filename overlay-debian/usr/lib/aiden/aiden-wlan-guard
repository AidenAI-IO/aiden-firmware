#!/bin/sh
set -eu

interface=${WLAN_GUARD_IFACE:-wlan0}
interval=${WLAN_GUARD_INTERVAL:-10}
threshold=${WLAN_GUARD_FAIL_THRESHOLD:-5}
cooldown=${WLAN_GUARD_RECOVER_COOLDOWN:-20}
max_recoveries=${WLAN_GUARD_MAX_RECOVERIES:-3}
healthy_threshold=${WLAN_GUARD_HEALTHY_THRESHOLD:-6}
log_file=${WLAN_GUARD_LOG_FILE:-/var/log/wlan_guard/wlan_guard.log}
for value in "${interval}" "${threshold}" "${cooldown}" "${max_recoveries}" "${healthy_threshold}"; do
    case "${value}" in ''|*[!0-9]*|0) exit 1 ;; esac
done

log() {
    message=$*
    logger -t aiden-wlan-guard "${message}" 2>/dev/null || true
    printf '%s %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)" \
        "${message}" >>"${log_file}" 2>/dev/null || true
    if [ -f "${log_file}" ]; then
        log_lines=$(wc -l <"${log_file}" 2>/dev/null || echo 0)
        case "${log_lines}" in ''|*[!0-9]*) log_lines=0 ;; esac
        if [ "${log_lines}" -gt 2000 ]; then
            tail -n 1000 "${log_file}" >"${log_file}.tmp.$$" 2>/dev/null &&
                cat "${log_file}.tmp.$$" >"${log_file}" 2>/dev/null &&
                rm -f "${log_file}.tmp.$$" 2>/dev/null || true
        fi
    fi
}
mark() {
    /usr/lib/aiden/aiden-boot-timeline mark "wlan-guard:$*" 2>/dev/null || true
}
gateway() {
    ip route show default dev "${interface}" 2>/dev/null \
        | awk '$1 == "default" && $2 == "via" {print $3; exit}'
}
reachable() {
    host=$(gateway)
    [ -n "${host}" ] || return 1
    ping -c 2 -W 1 -I "${interface}" "${host}" >/dev/null 2>&1 && return 0
    # Some gateways filter ICMP. A fresh ARP reply still proves the local
    # link is alive; an old neighbour-cache entry does not.
    arping -q -f -c 2 -w 3 -I "${interface}" "${host}" >/dev/null 2>&1
}
recover() {
    recover_gateway=$(gateway)
    log "recovery-begin interface=${interface} attempt=${recoveries} gateway=${recover_gateway}"
    mark "recovery-begin attempt=${recoveries}"
    if ! wpa_cli -i "${interface}" reassociate >/dev/null 2>&1; then
        log "reassociate result=failed"
    else
        log "reassociate result=sent"
    fi
    sleep 8
    if reachable; then
        log "recovery-end attempt=${recoveries} method=reassociate result=success"
        mark "recovery-end attempt=${recoveries} result=success"
        return 0
    fi
    log "reassociate result=unreachable; cycling interface through systemd network control"
    ip link set dev "${interface}" down || log "interface-down result=failed"
    sleep 2
    ip link set dev "${interface}" up || log "interface-up result=failed"
    if ! systemctl restart "wpa_supplicant@${interface}.service"; then
        log "supplicant-restart result=failed"
    fi
    networkctl reconfigure "${interface}" ||
        log "networkd-reconfigure result=failed"
    sleep 8
    if reachable; then
        log "recovery-end attempt=${recoveries} method=interface-cycle result=success"
        mark "recovery-end attempt=${recoveries} result=success"
    else
        log "recovery-end attempt=${recoveries} method=interface-cycle result=unreachable"
        mark "recovery-end attempt=${recoveries} result=unreachable"
    fi
}

failures=0
recoveries=0
healthy=0
exhausted=0
last_state=""
last_gateway=""
log "started interface=${interface} interval=${interval} threshold=${threshold} max_recoveries=${max_recoveries}"
mark "started interface=${interface}"
while :; do
    state=$(wpa_cli -i "${interface}" status 2>/dev/null |
        sed -n 's/^wpa_state=//p' | head -n 1)
    host=$(gateway)
    if [ "${state}" != COMPLETED ] || [ -z "${host}" ]; then
        if [ "${state}" != "${last_state}" ] || [ "${host}" != "${last_gateway}" ]; then
            log "link-not-ready wpa_state=${state:-missing} gateway=${host:-missing}"
            mark "link-not-ready wpa_state=${state:-missing} gateway=${host:-missing}"
            last_state=${state}
            last_gateway=${host}
        fi
        failures=0
        healthy=0
    elif reachable; then
        last_state=${state}
        last_gateway=${host}
        failures=0
        if [ "${recoveries}" -gt 0 ]; then
            healthy=$((healthy + 1))
            if [ "${healthy}" -ge "${healthy_threshold}" ]; then
                log "${interface} stable; recovery budget reset"
                mark "budget-reset"
                recoveries=0
                exhausted=0
                healthy=0
            fi
        fi
        address=$(ip -4 -o address show dev "${interface}" scope global \
            | awk '{sub(/\/.*/, "", $4); print $4; exit}')
        [ -z "${address}" ] || arping -q -U -c 1 -I "${interface}" "${address}" || true
    else
        healthy=0
        if [ "${recoveries}" -ge "${max_recoveries}" ]; then
            if [ "${exhausted}" -eq 0 ]; then
                log "recovery limit reached (${max_recoveries}); monitoring ${interface} without further resets"
                mark "budget-exhausted"
                exhausted=1
            fi
            sleep "${interval}"
            continue
        fi
        failures=$((failures + 1))
        log "gateway unreachable (${failures}/${threshold}) gateway=${host}"
        mark "gateway-failure count=${failures}"
        if [ "${failures}" -ge "${threshold}" ]; then
            recoveries=$((recoveries + 1))
            recover || true
            failures=0
            sleep "${cooldown}"
        fi
    fi
    sleep "${interval}"
done
