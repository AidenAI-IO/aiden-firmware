#!/bin/sh
set -eu

OTA_BIN=${OTA_BIN:-/oem/usr/bin/ota}
OTA_CONFIG=${OTA_CONFIG:-/userdata/debian/ota/config.json}
PENDING_PATH=${PENDING_PATH:-/userdata/ota/pending_boot.json}
BOOT_CONFIG=${BOOT_CONFIG:-/etc/aiden_boot.conf}
ENVIRONMENT_PATH=${ENVIRONMENT_PATH:-/run/aiden/system.env}
SYSTEMCTL_BIN=${SYSTEMCTL_BIN:-/usr/bin/systemctl}
CURL_BIN=${CURL_BIN:-/usr/bin/curl}
SLEEP_BIN=${SLEEP_BIN:-/usr/bin/sleep}
WAIT_SECONDS=${WAIT_SECONDS:-30}

[ -e "${PENDING_PATH}" ] || exit 0
[ -r "${BOOT_CONFIG}" ] || {
    echo "OTA local health: missing ${BOOT_CONFIG}" >&2
    exit 1
}

# This file is image-owned and contains only declarative feature switches.
# shellcheck disable=SC1090
. "${BOOT_CONFIG}"

feature_enabled() {
    case "$1" in
        ENABLE_AGENT) [ "${ENABLE_AGENT:-0}" = 1 ] ;;
        ENABLE_AUDIO_SERVICE) [ "${ENABLE_AUDIO_SERVICE:-0}" = 1 ] ;;
        ENABLE_BLE_SERVICE) [ "${ENABLE_BLE_SERVICE:-0}" = 1 ] ;;
        ENABLE_CONFIG_WEB) [ "${ENABLE_CONFIG_WEB:-0}" = 1 ] ;;
        ENABLE_FRAME_SERVICE) [ "${ENABLE_FRAME_SERVICE:-0}" = 1 ] ;;
        ENABLE_USB_DHCP) [ "${ENABLE_USB_DHCP:-0}" = 1 ] ;;
        ENABLE_USB_HID) [ "${ENABLE_USB_HID:-0}" = 1 ] ;;
        ENABLE_WIFIDRV) [ "${ENABLE_WIFIDRV:-0}" = 1 ] ;;
        ENABLE_WLAN_GUARD) [ "${ENABLE_WLAN_GUARD:-0}" = 1 ] ;;
        ENABLE_BLUETOOTH_HCI) [ "${ENABLE_BLUETOOTH_HCI:-0}" = 1 ] ;;
        *) return 1 ;;
    esac
}

service_active() {
    "${SYSTEMCTL_BIN}" is-active --quiet "$1"
}

wait_for() {
    description=$1
    shift
    remaining=${WAIT_SECONDS}
    while ! "$@"; do
        if [ "${remaining}" -le 0 ]; then
            echo "OTA local health failed: ${description}" >&2
            return 1
        fi
        "${SLEEP_BIN}" 1
        remaining=$((remaining - 1))
    done
}

path_exists() {
    [ -e "$1" ]
}

http_responds() {
    "${CURL_BIN}" --fail --silent --show-error --output /dev/null \
        --connect-timeout 1 --max-time 2 "$1"
}

[ -s "${ENVIRONMENT_PATH}" ] || {
    echo "OTA local health: normalized environment is missing" >&2
    exit 1
}

for service in \
    oem.mount userdata.mount userdata-ota.mount \
    aiden-userdata-migrate.service aiden-environment.service \
    systemd-networkd.service; do
    wait_for "${service} is not active" service_active "${service}"
done

if feature_enabled ENABLE_WIFIDRV; then
    wait_for "Wi-Fi driver service is not active" service_active aiden-wifi-driver.service
fi
if feature_enabled ENABLE_WLAN_GUARD; then
    wait_for "WLAN guard service is not active" service_active aiden-wlan-guard.service
fi
if feature_enabled ENABLE_BLUETOOTH_HCI; then
    wait_for "Bluetooth service is not active" service_active bluetooth.service
fi
if feature_enabled ENABLE_USB_HID; then
    wait_for "USB gadget service is not active" service_active aiden-usb-gadget.service
fi
if feature_enabled ENABLE_USB_DHCP; then
    wait_for "USB DHCP service is not active" service_active aiden-usb-dnsmasq.service
fi
if feature_enabled ENABLE_FRAME_SERVICE; then
    wait_for "frame service is not active" service_active aiden-frame.service
    wait_for "frame service socket is missing" path_exists /run/frame_service/frame_service.sock
fi
if feature_enabled ENABLE_AUDIO_SERVICE; then
    wait_for "audio service is not active" service_active aiden-audio.service
    wait_for "audio service socket is missing" path_exists /run/audio_service/audio_service.sock
fi
if feature_enabled ENABLE_BLE_SERVICE; then
    wait_for "BLE service is not active" service_active aiden-ble.service
    wait_for "BLE service socket is missing" path_exists /run/ble_service/ble_service.sock
fi
if feature_enabled ENABLE_AGENT; then
    wait_for "Agent service is not active" service_active aiden-agent.service
    wait_for "Agent local HTTP runtime is not responding" http_responds http://127.0.0.1:8080/
fi
if feature_enabled ENABLE_CONFIG_WEB; then
    wait_for "configuration portal is not active" service_active aiden-config-web.service
    wait_for "configuration portal is not responding" http_responds http://127.0.0.1/
fi

exec "${OTA_BIN}" --config "${OTA_CONFIG}" mark-health
