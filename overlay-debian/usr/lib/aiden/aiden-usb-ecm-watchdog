#!/bin/sh
set -eu

gadget_dir=${AIDEN_USB_GADGET_DIR:-/sys/kernel/config/usb_gadget/aiden_hid}
udc_file=${AIDEN_USB_UDC_FILE:-${gadget_dir}/UDC}
udc_name=${AIDEN_USB_UDC_NAME:-ffb00000.usb}
udc_state_file=${AIDEN_USB_UDC_STATE_FILE:-/sys/class/udc/${udc_name}/state}
usb_net_class=${AIDEN_USB_NET_CLASS_PATH:-/sys/class/net/usb0}
lease_file=${AIDEN_USB_LEASE_FILE:-/run/aiden/dnsmasq-usb0.leases}
lock_dir=${AIDEN_USB_LOCK_DIR:-/run/aiden_dynamic_keyboard.lock}
grace_file=${AIDEN_USB_GRACE_FILE:-/run/aiden_dynamic_keyboard.grace}
refresh_state_file=${AIDEN_USB_REFRESH_STATE_FILE:-/run/aiden_usb_ecm_watchdog.state}
interval=${USB_ECM_PROBE_INTERVAL:-5}
threshold=${USB_ECM_FAIL_THRESHOLD:-2}
cooldown=${USB_ECM_COOLDOWN:-30}

hosts() {
    {
        awk '$3 ~ /^192\.168\.42\./ && $3 != "192.168.42.1" {print $3}' \
            "${lease_file}" 2>/dev/null
        ip -4 neigh show dev usb0 2>/dev/null \
            | awk '$1 ~ /^192\.168\.42\./ && $1 != "192.168.42.1" {print $1}'
    } | sort -u
}

grace_active() {
    until=$(cat "${grace_file}" 2>/dev/null || echo 0)
    case "${until}" in ''|*[!0-9]*) until=0 ;; esac
    [ "${until}" -gt "$(date +%s)" ]
}

probe() {
    found=0
    for host in $(hosts); do
        found=1
        arping -q -c 2 -w 2 -I usb0 "${host}" && return 0
    done
    [ "${found}" -eq 1 ] && return 1
    return 2
}

acquire_lock() {
    if mkdir "${lock_dir}" 2>/dev/null; then
        echo $$ >"${lock_dir}/pid"
        return 0
    fi

    owner=$(cat "${lock_dir}/pid" 2>/dev/null || true)
    case "${owner}" in
        ''|*[!0-9]*) ;;
        *)
            if ! kill -0 "${owner}" 2>/dev/null; then
                rm -f "${lock_dir}/pid"
                rmdir "${lock_dir}" 2>/dev/null || true
                if mkdir "${lock_dir}" 2>/dev/null; then
                    echo $$ >"${lock_dir}/pid"
                    return 0
                fi
            fi
            ;;
    esac
    return 1
}
release_lock() {
    rm -f "${lock_dir}/pid"
    rmdir "${lock_dir}" 2>/dev/null || true
}

write_refresh_state() {
    reason=$1
    result=$2
    started_at=$3
    detail=$4
    state_dir=$(dirname "${refresh_state_file}")
    state_tmp=${refresh_state_file}.tmp.$$
    mkdir -p "${state_dir}"
    {
        printf 'last_refresh_epoch=%s\n' "$(date +%s)"
        printf 'last_refresh_reason=%s\n' "${reason}"
        printf 'last_refresh_result=%s\n' "${result}"
        printf 'last_refresh_started_epoch=%s\n' "${started_at}"
        printf 'last_refresh_detail=%s\n' "${detail}"
        printf 'udc_state=%s\n' "$(cat "${udc_state_file}" 2>/dev/null || true)"
        printf 'gadget_udc=%s\n' "$(cat "${udc_file}" 2>/dev/null || true)"
    } >"${state_tmp}"
    chmod 0644 "${state_tmp}"
    mv -f "${state_tmp}" "${refresh_state_file}"
}

reset_composite() (
    reason=${1:-manual refresh}
    started_at=$(date +%s)
    acquire_lock || exit 1
    trap release_lock EXIT HUP INT TERM
    grace_active && exit 0
    write_refresh_state "${reason}" started "${started_at}" "reset started"
    if [ ! -w "${udc_file}" ]; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC control is not writable"
        exit 1
    fi
    if ! printf '\n' >"${udc_file}"; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC unbind failed"
        exit 1
    fi
    sleep 1
    if ! printf '%s\n' "${udc_name}" >"${udc_file}"; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC rebind failed"
        exit 1
    fi
    elapsed=0
    while [ "${elapsed}" -lt 10 ]; do
        [ "$(cat "${udc_state_file}" 2>/dev/null || true)" = configured ] && break
        sleep 1
        elapsed=$((elapsed + 1))
    done
    if [ "$(cat "${udc_state_file}" 2>/dev/null || true)" != configured ]; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC did not reach configured"
        exit 1
    fi
    if [ -d "${usb_net_class}" ]; then
        ip link set dev usb0 up || true
        ip address replace 192.168.42.1/24 dev usb0 || true
    fi
    write_refresh_state "${reason}" ok "${started_at}" "reset complete"
)

case "${1:-watch}" in
    refresh)
        reset_composite "manual refresh"
        exit $?
        ;;
    watch)
        ;;
    *)
        echo "Usage: $0 [watch|refresh]" >&2
        exit 2
        ;;
esac

failures=0
last_reset=0
while :; do
    sleep "${interval}"
    [ "$(cat "${udc_state_file}" 2>/dev/null || true)" = configured ] || {
        failures=0
        continue
    }
    grace_active && { failures=0; continue; }
    if probe; then
        failures=0
        continue
    else
        result=$?
    fi
    [ "${result}" -eq 2 ] && { failures=0; continue; }
    failures=$((failures + 1))
    logger -t aiden-usb-ecm-watchdog "ECM probe failed (${failures}/${threshold})"
    now=$(date +%s)
    if [ "${failures}" -ge "${threshold}" ] && \
        [ $((now - last_reset)) -ge "${cooldown}" ]; then
        logger -t aiden-usb-ecm-watchdog "resetting stalled composite gadget"
        reset_composite "ECM stall" || logger -t aiden-usb-ecm-watchdog "composite reset failed"
        last_reset=${now}
        failures=0
    fi
done
