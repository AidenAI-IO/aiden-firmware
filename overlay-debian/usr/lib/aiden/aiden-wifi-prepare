#!/bin/sh
set -eu

log() {
    echo "aiden-wifi-prepare: $*" >&2
}

# Only SCH v1 routes WL_EN to GPIO3_C5 (package pin 3), through R169
# to module pin 12. WIFI_VCC_PWREN remains under the companion MCU.
model=$(tr -d '\000' < /proc/device-tree/model 2>/dev/null || true)
[ "$model" = "Aiden SCH v1" ] || exit 0
if [ -e /sys/class/net/wlan0 ]; then
    log "result=skip reason=wlan0-present"
    exit 0
fi
# A reset must not invalidate handles held by a running AIC/BT driver.
# A normal boot reaches this helper before any AIC module is loaded.
for module in aic8800_bsp aic8800_fdrv aic8800_btlpm; do
    if [ -d "/sys/module/$module" ]; then
        log "result=failed reason=driver-already-loaded module=$module"
        exit 1
    fi
done

# This controller is SCH v1 Wi-Fi only, not the eMMC/root filesystem.
host=ff9a0000.mmc
driver=/sys/bus/platform/drivers/dwmmc_rockchip
gpio=/sys/class/gpio/gpio117
if [ ! -e "$driver/$host" ]; then
    log "result=failed reason=sdio-host-unbound host=$host"
    exit 1
fi
if [ ! -d "$gpio" ]; then
    echo 117 > /sys/class/gpio/export
fi

# Leave WL_EN high and restore the host if any intermediate operation fails.
# Keep the GPIO exported/high for the rest of the boot.
detached=0
# Called indirectly by the EXIT trap.
# shellcheck disable=SC2317
cleanup() {
    status=$?
    trap - EXIT
    if [ "$status" -ne 0 ]; then
        echo high > "$gpio/direction" || true
        if [ "$detached" -eq 1 ]; then
            echo "$host" > "$driver/bind" || true
        fi
        log "result=failed status=$status"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

log "action=reset host=$host gpio=117 low_ms=1000 settle_ms=2000"
echo "$host" > "$driver/unbind"
detached=1
echo low > "$gpio/direction"
sleep 1
echo 1 > "$gpio/value"
sleep 2
echo "$host" > "$driver/bind"
detached=0

# non-removable hosts scan only once; WL_EN alone does not trigger a rescan.
# Wait for both AIC8800D80 SDIO functions before loading the BSP/firmware.
attempt=0
while [ "$attempt" -lt 50 ]; do
    ready=0
    for device in /sys/bus/platform/devices/"$host"/mmc_host/mmc*/*/*; do
        if [ ! -f "$device/vendor" ] || [ ! -f "$device/device" ]; then
            continue
        fi
        [ "$(cat "$device/vendor")" = "0xc8a1" ] || continue
        case "$(cat "$device/device")" in
            0x0082) ready=$((ready | 1)) ;;
            0x0182) ready=$((ready | 2)) ;;
        esac
    done
    if [ "$ready" -eq 3 ]; then
        log "result=success host=$host sdio=c8a1:0082,c8a1:0182"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done
log "result=failed reason=sdio-enumeration-timeout host=$host"
exit 1
