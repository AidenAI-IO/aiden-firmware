#!/bin/sh
set -eu

log() {
    echo "aiden-wifi-prepare: $*" >&2
}

model=$(tr -d '\000' < /proc/device-tree/model 2>/dev/null || true)
[ "$model" = "Aiden SCH v1" ] || exit 0

# The MCU owns module power. The kernel handles retained SDIO enumeration;
# preparing the driver must preserve the module and the existing host/card.
host=ff9a0000.mmc
if [ ! -e /sys/firmware/devicetree/base/mmc@ff9a0000/aiden,aic8800d80-retained-sdio ]; then
    log "result=failed reason=retained-sdio-not-configured host=$host"
    exit 1
fi
if [ ! -e "/sys/bus/platform/drivers/dwmmc_rockchip/$host" ]; then
    log "result=failed reason=sdio-host-unbound host=$host"
    exit 1
fi

matches() {
    [ -r "$1/vendor" ] && [ -r "$1/device" ] &&
        [ "$(cat "$1/vendor")" = "0xc8a1" ] &&
        [ "$(cat "$1/device")" = "$2" ]
}

# Require function 1 and function 2 on the same card, not a pair collected
# from unrelated cards. Driver insertion is synchronous after enumeration.
attempt=0
while [ "$attempt" -lt 50 ]; do
    for card in /sys/bus/platform/devices/"$host"/mmc_host/mmc*/*; do
        [ -d "$card" ] || continue
        card_name=${card##*/}
        if matches "$card/$card_name:1" 0x0082 &&
            matches "$card/$card_name:2" 0x0182; then
            log "result=success host=$host card=$card_name sdio=c8a1:0082,c8a1:0182"
            exit 0
        fi
    done
    attempt=$((attempt + 1))
    sleep 0.1
done
log "result=failed reason=sdio-enumeration-timeout host=$host"
exit 1
