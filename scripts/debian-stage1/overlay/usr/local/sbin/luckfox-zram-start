#!/bin/sh
set -eu

if [ ! -b /dev/zram0 ]; then
    if ! modprobe -q zram num_devices=1 2>/dev/null; then
        cat /sys/class/zram-control/hot_add >/dev/null
    fi
fi

count=0
while [ ! -b /dev/zram0 ] && [ "${count}" -lt 50 ]; do
    count=$((count + 1))
    sleep 0.1
done
test -b /dev/zram0

swapoff /dev/zram0 2>/dev/null || true
echo 67108864 > /sys/block/zram0/disksize
mkswap /dev/zram0
swapon -p 100 /dev/zram0
