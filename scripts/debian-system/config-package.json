{
  "format": 1,
  "include": [
    "etc/aiden/**",
    "etc/default/aiden-*",
    "etc/aiden_*.conf",
    "etc/locale.conf",
    "etc/profile.d/aiden-*.sh",
    "etc/sudoers.d/*-aiden-*",
    "etc/ssh/sshrc",
    "etc/ssh/sshd_config.d/*-aiden.conf",
    "etc/dnsmasq.d/usb0.conf",
    "etc/dnsmasq.d/aiden*.conf",
    "etc/systemd/network/20-wlan0.network",
    "etc/systemd/network/30-usb0.network",
    "etc/systemd/network/*-aiden-*.network",
    "etc/systemd/journald.conf.d/*-aiden.conf",
    "etc/systemd/system/aiden*.service",
    "etc/systemd/system/aiden*.path",
    "etc/systemd/system/aiden*.timer",
    "etc/systemd/system/aiden.target",
    "etc/systemd/system/*.service.d/*-aiden.conf",
    "etc/systemd/system/*.device.d/*-aiden-optional.conf",
    "etc/tmpfiles.d/aiden*.conf",
    "etc/udev/rules.d/*-aiden-*.rules",
    "usr/lib/aiden/aiden-*"
  ],
  "exclude": [
    "usr/lib/aiden/aiden-apt-source",
    "usr/lib/aiden/aiden-machine-id-provision",
    "usr/lib/aiden/aiden-media-modules",
    "usr/lib/aiden/aiden-ota-*",
    "usr/lib/aiden/aiden-root-home",
    "usr/lib/aiden/aiden-rootfs-grow",
    "usr/lib/aiden/aiden-slot-resolve",
    "usr/lib/aiden/aiden-ssh-identity",
    "usr/lib/aiden/aiden-user-home",
    "usr/lib/aiden/aiden-userdata-migrate",
    "usr/lib/aiden/aiden-wifi-driver",
    "etc/systemd/system/aiden-environment.service",
    "etc/systemd/system/aiden-machine-id.service",
    "etc/systemd/system/aiden-media-modules.service",
    "etc/systemd/system/aiden-ota-*",
    "etc/systemd/system/aiden-platform-ldconfig.service",
    "etc/systemd/system/aiden-root-home.service",
    "etc/systemd/system/aiden-rootfs-grow.service",
    "etc/systemd/system/aiden-slot-resolve.service",
    "etc/systemd/system/aiden-ssh-identity.service",
    "etc/systemd/system/aiden-user-home.service",
    "etc/systemd/system/aiden-userdata-migrate.service",
    "etc/systemd/system/aiden-wifi-driver.service"
  ],
  "live": [
    "etc/ssh/sshrc",
    "etc/profile.d/*",
    "etc/sudoers.d/*",
    "etc/locale.conf",
    "etc/aiden_audio_service.conf",
    "etc/aiden_ble_service.conf",
    "etc/aiden_frame_service.conf",
    "etc/tmpfiles.d/aiden.conf",
    "etc/systemd/system/aiden-agent.service",
    "etc/systemd/system/aiden-audio.service",
    "etc/systemd/system/aiden-ble.service",
    "etc/systemd/system/aiden-config-web.service",
    "etc/systemd/system/aiden-frame.service",
    "etc/systemd/system/aiden-ttyd.service",
    "etc/systemd/system/aiden-wifi-proxy*",
    "usr/lib/aiden/aiden-agent-control",
    "usr/lib/aiden/aiden-feature-enabled",
    "usr/lib/aiden/aiden-frame-control",
    "usr/lib/aiden/aiden-frame-start",
    "usr/lib/aiden/aiden-log.sh",
    "usr/lib/aiden/aiden-managed-env-run",
    "usr/lib/aiden/aiden-python-prepare",
    "usr/lib/aiden/aiden-ssh-session-tty",
    "usr/lib/aiden/aiden-ttyd-*",
    "usr/lib/aiden/aiden-wifi-proxy-*"
  ]
}
