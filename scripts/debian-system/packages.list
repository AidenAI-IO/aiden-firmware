# Debian 13 production runtime. Keep this list free of alternate network
# managers, vendor kernels and bootloader packages.
systemd-sysv
udev
dbus
kmod
# Registers each login as a logind session scope. Without it sshd sessions stay
# in the ssh.service cgroup, which KillMode=process leaves running, so a
# poweroff never terminates them and SSH clients hang until the final kill.
libpam-systemd
openssh-server
sudo
ca-certificates
curl
python3
python3-pip
adb
android-sdk-platform-tools-common
iproute2
iputils-ping
iputils-arping
iw
rfkill
wireless-regdb
wpasupplicant
bluez
systemd-resolved
systemd-timesyncd
dnsmasq-base
procps
psmisc
util-linux
e2fsprogs
dosfstools
rsync
ethtool
usbutils
i2c-tools
alsa-utils
v4l-utils
libdrm2
file
tzdata
