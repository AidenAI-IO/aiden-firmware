diff --git a/sysdrv/source/kernel/drivers/phy/rockchip/phy-rockchip-inno-usb2.c b/sysdrv/source/kernel/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
--- a/sysdrv/source/kernel/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
+++ b/sysdrv/source/kernel/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
@@ -2825,8 +2825,8 @@ static int rv1106_usb2phy_tuning(struct rockchip_usb2phy *rphy)
 	/* Turn off differential receiver by default to save power */
 	phy_clear_bits(rphy->phy_base + 0x100, BIT(6));
 
-	/* Set 45ohm HS ODT value to 5'b10111 to increase driver strength */
-	phy_update_bits(rphy->phy_base + 0x11c, GENMASK(4, 0), 0x17);
+	/* Set HS ODT compensation to 5'b11111 to improve signal margin */
+	phy_update_bits(rphy->phy_base + 0x11c, GENMASK(4, 0), 0x1f);
 
 	/* Set Tx HS eye height tuning to 3'b011(462 mV)*/
 	phy_update_bits(rphy->phy_base + 0x124, GENMASK(4, 2), (0x03 << 2));
diff --git a/sysdrv/source/uboot/u-boot/board/rockchip/evb_rv1106/evb_rv1106.c b/sysdrv/source/uboot/u-boot/board/rockchip/evb_rv1106/evb_rv1106.c
--- a/sysdrv/source/uboot/u-boot/board/rockchip/evb_rv1106/evb_rv1106.c
+++ b/sysdrv/source/uboot/u-boot/board/rockchip/evb_rv1106/evb_rv1106.c
@@ -13,6 +13,8 @@ DECLARE_GLOBAL_DATA_PTR;
 
 #define CRU_BASE		0xFF3B2000
 #define CRU_SOFTRST_CON04	0x0A10
+#define USB2PHY_APB_BASE	0xFF3E0000
+#define USB2PHY_HS_ODT		0x011C
 
 #ifdef CONFIG_USB_DWC3
 static struct dwc3_device dwc3_device_data = {
@@ -43,11 +45,18 @@ static void usb_reset_otg_controller(void)
 
 int board_usb_init(int index, enum usb_init_type init)
 {
+	u32 reg;
+
 #ifdef CONFIG_SUPPORT_USBPLUG
 	usb_reset_otg_controller();
 #endif
 	writel(0x01ff0000, 0xff000050); /* Resume usb2 phy to normal mode */
 
+	/* Match the Linux HS ODT compensation before gadget enumeration */
+	reg = readl(USB2PHY_APB_BASE + USB2PHY_HS_ODT);
+	reg = (reg & ~GENMASK(4, 0)) | 0x1f;
+	writel(reg, USB2PHY_APB_BASE + USB2PHY_HS_ODT);
+
 	return dwc3_uboot_init(&dwc3_device_data);
 }
 #endif
diff --git a/sysdrv/source/uboot/u-boot/configs/aiden-rv1106-rockusb.config b/sysdrv/source/uboot/u-boot/configs/aiden-rv1106-rockusb.config
