# Python (uv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
benchmark/runs/
benchmark/artifacts/
benchmark/webui_test/
benchmark/benchmark_validation/

# MobileGym vendor - allow submodule but ignore its contents
benchmark/mobilegym/vendor/*
!benchmark/mobilegym/vendor/mobilegym/

# MobileGym daemon runtime state (regenerated each run)
benchmark/mobilegym/config/agent.toml
benchmark/mobilegym/config/agent.toml.*
!benchmark/mobilegym/config/agent.toml.template
benchmark/mobilegym/config/memory/
benchmark/mobilegym/config/log/
benchmark/mobilegym/config/control_token
benchmark/mobilegym/config/bridge_token

# Locally built daemon binary
/bin/

# MobileGym local launcher state (PIDs/logs)
/.mobilegym_run/

# Agent runtime state (regenerated at runtime; keep the committed template)
src/agent/config/log/

# Docker
benchmark/mobilegym/docker/.env
benchmark/state.json
skillopt/runs/

# VPhone local environment (machine-specific paths/hosts; use vphone.env.example)
benchmark/vphone/vphone.env

