{
  "kind": "unit",
  "name": "quick_action_android_v1",
  "description": "Deterministic unit tests for quick_action on Android.",
  "target": {
    "type": "tool",
    "name": "quick_action"
  },
  "defaults": {
    "timeout_ms": 10000
  },
  "tests": [
    {
      "id": "list_android_actions",
      "input": {
        "list": true,
        "platform": "android"
      },
      "expect": {
        "ok": true,
        "contains": ["actions"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "android_back_active",
      "input": {
        "action": "back",
        "platform": "android"
      },
      "expect": {
        "ok": true,
        "contains": ["back"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
