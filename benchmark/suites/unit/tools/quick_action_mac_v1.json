{
  "kind": "unit",
  "name": "quick_action_mac_v1",
  "description": "Deterministic unit tests for quick_action on macOS.",
  "target": {
    "type": "tool",
    "name": "quick_action"
  },
  "defaults": {
    "timeout_ms": 10000
  },
  "tests": [
    {
      "id": "list_mac_actions",
      "input": {
        "list": true,
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["actions"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_spotlight_search_active",
      "input": {
        "action": "spotlight_search",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["spotlight_search", "sequence", "backspace", "delay_ms_after"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_home_reserved",
      "input": {
        "action": "home",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["reserved"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_app_switch_active",
      "input": {
        "action": "app_switch",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["app_switch"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_hide_app_active",
      "input": {
        "action": "hide_app",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["hide_app"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_browser_new_tab_active",
      "input": {
        "action": "browser_new_tab",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["browser_new_tab"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_alias_global_search",
      "input": {
        "action": "global_search",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["spotlight_search", "sequence", "backspace"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_force_quit_reserved",
      "input": {
        "action": "force_quit",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["reserved"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "mac_unknown_action",
      "input": {
        "action": "definitely_not_an_action",
        "platform": "mac"
      },
      "expect": {
        "ok": true,
        "contains": ["unknown action"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    }
  ]
}
