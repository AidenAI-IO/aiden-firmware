{
  "kind": "unit",
  "name": "quick_action_ios_v1",
  "description": "Deterministic unit tests for quick_action on iOS.",
  "target": {
    "type": "tool",
    "name": "quick_action"
  },
  "defaults": {
    "timeout_ms": 10000
  },
  "tests": [
    {
      "id": "list_ios_actions",
      "input": {
        "list": true,
        "platform": "ios"
      },
      "expect": {
        "ok": true,
        "contains": ["actions"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "ios_back_active",
      "input": {
        "action": "back",
        "platform": "ios"
      },
      "expect": {
        "ok": true,
        "contains": ["back"],
        "json": {
          "width": { "type": "number" },
          "height": { "type": "number" },
          "data": { "type": "string", "min_len": 1 },
          "action_output": { "type": "string", "min_len": 1 }
        }
      }
    },
    {
      "id": "ios_app_drawer_reserved",
      "input": {
        "action": "app_drawer",
        "platform": "ios"
      },
      "expect": {
        "ok": true,
