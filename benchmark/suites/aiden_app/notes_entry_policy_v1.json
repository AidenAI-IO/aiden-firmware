{
  "name": "aiden_app_notes_entry_policy_v1",
  "suite_category": "Aiden App / Phone Bridge Policy",
  "description": "Prompt-conditioned Notes entry policy cases collected in one suite with task-level mock environments.",
  "prompt_prefix": "这是 Aiden Phone Bridge 工具选择 benchmark。测试环境状态会在每个任务中直接声明；按声明状态选择最直接的 App 进入方式，不要额外猜测屏幕内容。联系人等系统数据必须通过可用的 Phone Bridge 数据工具查询。向可见编辑框写入最终内容时，根据 runtime text-entry strategy 选择输入工具。",
  "global_reset": {},
  "tasks": [
    {
      "id": "ios_pip_notes_already_open",
      "category": "multi_step",
      "description_for_judge": "Notes is already open. Query Biden and enter the returned number without reopening or searching for Notes.",
      "prompt": "测试环境状态：当前已经位于 Apple 备忘录的空白编辑页，正文输入区域中心约为 normalized x=500、y=360。Aiden 在后台，iOS PiP Bridge 已开启。查询通讯录中 Biden 的手机号，把查询到的手机号写进当前备忘录；不要重新打开或搜索 App。",
      "mock_environment": {
        "phone_bridge": {
          "connected": false,
          "platform": "ios",
          "phone_id": "benchmark-ios-pip-notes-open",
          "app_state": "background",
          "return_entry": "dynamic_island",
          "return_entry_available": true,
          "pip_bridge_enabled": true,
          "fgs_bridge_enabled": false
        },
        "screen_text": "Apple Notes is already open on a blank note editor around normalized x=500, y=360.",
        "tools": {
          "bridge_contacts": {
            "input_contains": {"action": "query", "query": "Biden"},
            "output": {
              "ok": true,
              "contacts": [{"id": "biden", "name": "Biden", "phone_numbers": ["+1 202-555-0147"]}]
            }
          },
          "enter_text_via_bridge": {
            "input_contains": {
              "text": "+1 202-555-0147",
              "platform": "ios",
              "focus": {"coord_space": "normalized"}
            },
            "screen_contains": "Apple Notes is already open",
            "output": {"ok": true, "committed": true, "field_text": "+1 202-555-0147"},
            "screen_text": "Apple Notes contains exactly: +1 202-555-0147"
          }
        }
      },
      "rubric": [
        {"id": "queried_contact", "check": "Calls bridge_contacts with action=query and query=Biden."},
        {"id": "did_not_reopen", "check": "Does not call search_launch_app or bridge_open_app because Notes is already open."},
        {"id": "entered_number", "check": "Calls enter_text_via_bridge with the returned number and platform=ios."}
      ],
      "hard_assertions": {
        "min_tool_calls": 2,
        "max_tool_calls": 8,
        "must_complete_within_sec": 180,
        "required_tools": ["bridge_contacts", "enter_text_via_bridge"],
        "forbidden_tools": ["search_launch_app", "bridge_open_app", "bridge_clipboard"],
        "required_tool_calls": [
          {"tool": "bridge_contacts", "input_contains": {"action": "query", "query": "Biden"}},
          {
            "tool": "enter_text_via_bridge",
            "input_contains": {"text": "+1 202-555-0147", "platform": "ios", "focus": {"coord_space": "normalized"}}
          }
        ]
      }
    },
    {
      "id": "ios_pip_notes_icon_visible",
      "category": "multi_step",
      "description_for_judge": "The Notes icon is directly visible. Query Biden, click the icon, and enter the returned number without searching.",
      "prompt": "测试环境状态：当前是 iPhone 主界面，Apple 备忘录图标清晰可见，中心为 normalized x=180、y=310。Aiden 在后台，iOS PiP Bridge 已开启。查询 Biden 的手机号，直接点击可见图标进入备忘录并写入号码；不要调用 search_launch_app。",
      "mock_environment": {
        "phone_bridge": {
          "connected": false,
          "platform": "ios",
          "phone_id": "benchmark-ios-pip-notes-icon",
          "app_state": "background",
          "return_entry": "dynamic_island",
          "return_entry_available": true,
          "pip_bridge_enabled": true,
          "fgs_bridge_enabled": false
        },
        "screen_text": "iPhone home screen with Apple Notes icon at normalized x=180, y=310.",
        "tools": {
          "bridge_contacts": {
            "input_contains": {"action": "query", "query": "Biden"},
            "output": {
              "ok": true,
              "contacts": [{"id": "biden", "name": "Biden", "phone_numbers": ["+1 202-555-0147"]}]
            }
          },
          "mouse_click": {
            "input_contains": {"x": 180, "y": 310, "coord_space": "normalized"},
            "screen_contains": "Apple Notes icon",
            "output": {"ok": true, "clicked": true},
            "screen_text": "Apple Notes is open on a blank note editor around normalized x=500, y=360."
          },
          "enter_text_via_bridge": {
            "input_contains": {
              "text": "+1 202-555-0147",
              "platform": "ios",
              "focus": {"coord_space": "normalized"}
            },
            "screen_contains": "Apple Notes is open",
            "output": {"ok": true, "committed": true, "field_text": "+1 202-555-0147"},
            "screen_text": "Apple Notes contains exactly: +1 202-555-0147"
          }
        }
      },
      "rubric": [
        {"id": "queried_contact", "check": "Calls bridge_contacts with action=query and query=Biden."},
        {"id": "clicked_visible_icon", "check": "Clicks normalized x=180, y=310 and does not search for Notes."},
        {"id": "entered_number", "check": "Calls enter_text_via_bridge with the returned number."}
      ],
      "hard_assertions": {
        "min_tool_calls": 3,
        "max_tool_calls": 10,
        "must_complete_within_sec": 180,
        "required_tools": ["bridge_contacts", "mouse_click", "enter_text_via_bridge"],
        "forbidden_tools": ["search_launch_app", "bridge_open_app", "bridge_clipboard"],
        "required_tool_calls": [
          {"tool": "bridge_contacts", "input_contains": {"action": "query", "query": "Biden"}},
          {"tool": "mouse_click", "input_contains": {"x": 180, "y": 310, "coord_space": "normalized"}},
          {"tool": "enter_text_via_bridge", "input_contains": {"text": "+1 202-555-0147", "platform": "ios"}}
        ]
      }
    },
    {
      "id": "ios_pip_notes_icon_missing",
      "category": "multi_step",
      "description_for_judge": "Neither Notes nor its icon is visible. Query Biden, use search_launch_app, and enter the returned number.",
      "prompt": "测试环境状态：当前是 iPhone 主界面，画面中没有打开的备忘录，也看不到备忘录图标。Aiden 在后台，iOS PiP Bridge 已开启。查询 Biden 的手机号，使用 search_launch_app 进入备忘录并写入号码。",
      "mock_environment": {
        "phone_bridge": {
          "connected": false,
          "platform": "ios",
          "phone_id": "benchmark-ios-pip-notes-missing",
          "app_state": "background",
          "return_entry": "dynamic_island",
          "return_entry_available": true,
          "pip_bridge_enabled": true,
          "fgs_bridge_enabled": false
        },
        "screen_text": "iPhone home screen without an open Notes page or visible Notes icon.",
        "tools": {
          "bridge_contacts": {
            "input_contains": {"action": "query", "query": "Biden"},
            "output": {
              "ok": true,
              "contacts": [{"id": "biden", "name": "Biden", "phone_numbers": ["+1 202-555-0147"]}]
            }
          },
          "search_launch_app": [
            {
              "input_contains": {"app": "备忘录"},
              "output": {"ok": true, "target": "备忘录"},
              "screen_text": "Apple Notes is open on a blank note editor around normalized x=500, y=360."
            },
            {
              "input_contains": {"app": "Notes"},
              "output": {"ok": true, "target": "Notes"},
              "screen_text": "Apple Notes is open on a blank note editor around normalized x=500, y=360."
            }
          ],
          "enter_text_via_bridge": {
            "input_contains": {"text": "+1 202-555-0147", "platform": "ios"},
            "screen_contains": "Apple Notes is open",
            "output": {"ok": true, "committed": true, "field_text": "+1 202-555-0147"},
            "screen_text": "Apple Notes contains exactly: +1 202-555-0147"
          }
        }
      },
      "rubric": [
        {"id": "queried_contact", "check": "Calls bridge_contacts with action=query and query=Biden."},
        {"id": "searched_for_notes", "check": "Calls search_launch_app because Notes and its icon are unavailable."},
        {"id": "entered_number", "check": "Calls enter_text_via_bridge with the returned number."}
      ],
      "hard_assertions": {
        "min_tool_calls": 3,
        "max_tool_calls": 12,
        "must_complete_within_sec": 180,
        "required_tools": ["bridge_contacts", "search_launch_app", "enter_text_via_bridge"],
        "forbidden_tools": ["bridge_open_app", "bridge_clipboard"],
        "required_tool_calls": [
          {"tool": "bridge_contacts", "input_contains": {"action": "query", "query": "Biden"}},
          {"tool": "search_launch_app"},
          {"tool": "enter_text_via_bridge", "input_contains": {"text": "+1 202-555-0147", "platform": "ios"}}
        ]
      }
    }
  ]
}
