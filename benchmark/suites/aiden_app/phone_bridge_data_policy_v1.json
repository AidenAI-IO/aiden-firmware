        {"id": "completed", "check": "Reports successful notification send."}
      ],
      "hard_assertions": {
        "min_tool_calls": 1, "max_tool_calls": 4, "must_complete_within_sec": 120,
        "required_tools": ["bridge_notification"],
        "forbidden_tools": ["bridge_open_app", "search_launch_app", "touch_gesture"],
        "required_tool_calls": [{"tool": "bridge_notification", "input_contains": {"title": "PiP Benchmark", "body": "后台通知成功", "sound": true}}]
      }
    },
