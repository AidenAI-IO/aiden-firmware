        {"id": "completed", "check": "Reports successful clipboard write."}
      ],
      "hard_assertions": {
        "min_tool_calls": 1, "max_tool_calls": 4, "must_complete_within_sec": 120,
        "required_tools": ["bridge_clipboard"],
        "forbidden_tools": ["bridge_open_app", "search_launch_app", "touch_gesture", "enter_text"],
