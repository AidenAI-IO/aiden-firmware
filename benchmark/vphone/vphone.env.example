# VPhone iOS benchmark environment — template.
#
# Copy this file to `vphone.env` next to it and fill in the paths/host for your
# machine. `start.sh` and `start_bridge.py` load `vphone.env` by default; the
# real file is gitignored so local paths and hosts stay off the repo.
#
#   cp vphone.env.example vphone.env
#   $EDITOR vphone.env

# Repo checkout locations (absolute paths on your machine).
VPHONE_HARDWARE_DEMO_ROOT=/path/to/hardware-demo
VPHONE_BENCHMARK_ROOT=/path/to/hardware-demo/benchmark
VPHONE_AGENT_CONFIG=/path/to/agent.toml
VPHONE_ENV_FILE=/path/to/hardware-demo/benchmark/vphone/vphone.env

# vphone-cli checkout and its VM host-control Unix socket.
VPHONE_CLI_ROOT=/path/to/vphone-cli
VPHONE_SOCKET=/path/to/vphone-cli/vm/vphone.sock

# Guest VM SSH fallback. VPHONE_GUEST_SSH_HOST is a DHCP-assigned address that
# changes on each VM boot; `start.sh bridge` auto-detects it and only falls back
# to this value. VPHONE_GUEST_SSH_IDENTITY is the path to your SSH private key.
VPHONE_GUEST_SSH_HOST=192.168.64.2
VPHONE_GUEST_SSH_PORT=22222
VPHONE_GUEST_SSH_USER=root
VPHONE_GUEST_SSH_IDENTITY=/path/to/.ssh/vphone_ecdsa

# Local bridge bind address and the benchmark task id used by the CLI flow.
VPHONE_BRIDGE_HOST=127.0.0.1
VPHONE_BRIDGE_PORT=8899
VPHONE_BRIDGE_ENDPOINT=http://127.0.0.1:8899
VPHONE_BENCHMARK_TASK_ID=vphone-ios-cli
