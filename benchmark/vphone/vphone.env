# mac-black VPhone iOS benchmark environment.
# Source this file in shell commands; start_bridge.py also loads it by default.

VPHONE_HARDWARE_DEMO_ROOT=/Volumes/aiden/hardware-demo
VPHONE_BENCHMARK_ROOT=/Volumes/aiden/hardware-demo/benchmark
VPHONE_AGENT_CONFIG=/Volumes/aiden/config/agent.toml
VPHONE_ENV_FILE=/Volumes/aiden/hardware-demo/benchmark/vphone/vphone.env

VPHONE_CLI_ROOT=/Users/miao/dev/vphone-cli
VPHONE_SOCKET=/Users/miao/dev/vphone-cli/vm/vphone.sock

VPHONE_GUEST_SSH_HOST=192.168.64.8
VPHONE_GUEST_SSH_PORT=22222
VPHONE_GUEST_SSH_USER=root
VPHONE_GUEST_SSH_IDENTITY=/Users/miao/.ssh/vphone_ecdsa

VPHONE_BRIDGE_HOST=127.0.0.1
VPHONE_BRIDGE_PORT=8899
VPHONE_BRIDGE_ENDPOINT=http://127.0.0.1:8899
VPHONE_BENCHMARK_TASK_ID=vphone-ios-cli
