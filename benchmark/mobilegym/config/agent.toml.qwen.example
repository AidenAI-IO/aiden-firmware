# 使用内部 Qwen 代理的配置示例
# 复制到 agent.toml 后即可使用

instruction = "You are controlling an Android-like MobileGym simulator. Use screenshot and touch tools."
input_mode = "text"
max_iterations = 20

[model]
provider = "openai"  # 用 OpenAI 协议（兼容）
model = "qwen3.6-35b"
base_url = "https://proxy.seeklab.io/qwen/v1"
api_key = "sk-qwen36-e56165c3d052b0b433d09c25197bd6dd"
temperature = 0.2
max_tokens = 2000

[device]
backend = "mobilegym"
bridge_url = "http://mobilegym:4173"
bridge_token_file = "/config/bridge_token"
control_token_file = "/config/control_token"
