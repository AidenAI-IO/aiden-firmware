#!/bin/sh
# Aiden override: optional sshd startup.

BOOT_CONF=/etc/aiden_boot.conf

if [ -f "$BOOT_CONF" ]; then
	. "$BOOT_CONF"
fi
: "${ENABLE_SSHD:=1}"

umask 077

is_running() {
	pidof sshd >/dev/null 2>&1
}

start() {
	if [ "$ENABLE_SSHD" != "1" ]; then
		echo "sshd disabled by config (ENABLE_SSHD=$ENABLE_SSHD)"
		return 0
	fi

	if is_running; then
		echo "sshd already running"
		return 0
	fi

	if [ ! -x /usr/sbin/sshd ]; then
		echo "sshd binary not found: /usr/sbin/sshd"
		return 1
	fi
	if [ ! -x /usr/bin/ssh-keygen ]; then
		echo "ssh-keygen not found: /usr/bin/ssh-keygen"
		return 1
	fi

	chown root:root /var/empty/ 2>/dev/null || true
	/usr/bin/ssh-keygen -A >/dev/null 2>&1 || true
	printf "Starting sshd: "
	/usr/sbin/sshd >/dev/null 2>&1
	rc="$?"
	if [ "$rc" -ne 0 ]; then
		echo "FAIL (exit=$rc)"
		return "$rc"
	fi
	if ! is_running; then
		echo "FAIL (not running after start)"
		return 1
	fi
	touch /var/lock/sshd
	echo "OK"
	return 0
}

stop() {
	printf "Stopping sshd: "
	if is_running; then
		killall sshd 2>/dev/null || true
		sleep 1
	fi
	rm -f /var/lock/sshd
	if is_running; then
		echo "FAIL (still running)"
		return 1
	fi
	echo "OK"
	return 0
}

restart() {
	stop
	start
}

status() {
	if is_running; then
		echo "sshd=running"
		return 0
	fi
	echo "sshd=stopped"
	return 1
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) restart ;;
	status) status ;;
	*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
