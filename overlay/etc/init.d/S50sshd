#!/bin/sh
# Aiden override: optional sshd startup.

BOOT_CONF=${BOOT_CONF:-/etc/aiden_boot.conf}
SSHD_BIN=${SSHD_BIN:-/usr/sbin/sshd}
SSH_KEYGEN_BIN=${SSH_KEYGEN_BIN:-/usr/bin/ssh-keygen}
PIDOF_BIN=${PIDOF_BIN:-pidof}
KILLALL_BIN=${KILLALL_BIN:-killall}
LOCK_FILE=${LOCK_FILE:-/var/lock/sshd}

if [ -f "$BOOT_CONF" ]; then
	. "$BOOT_CONF"
fi
: "${ENABLE_SSHD:=1}"

umask 077

is_running() {
	"$PIDOF_BIN" sshd >/dev/null 2>&1
}

start() {
	if [ "$ENABLE_SSHD" != "1" ]; then
		echo "sshd disabled by config (ENABLE_SSHD=$ENABLE_SSHD)"
		return 0
	fi

	if is_running; then
		echo "sshd already running"
		return 0
	fi

	if [ ! -x "$SSHD_BIN" ]; then
		echo "sshd binary not found: $SSHD_BIN"
		return 1
	fi
	if [ ! -x "$SSH_KEYGEN_BIN" ]; then
		echo "ssh-keygen not found: $SSH_KEYGEN_BIN"
		return 1
	fi

	chown root:root /var/empty/ 2>/dev/null || true
	"$SSH_KEYGEN_BIN" -A >/dev/null 2>&1 || true
	printf "Starting sshd: "
	"$SSHD_BIN" >/dev/null 2>&1
	rc="$?"
	if [ "$rc" -ne 0 ]; then
		echo "FAIL (exit=$rc)"
		return "$rc"
	fi
	if ! is_running; then
		echo "FAIL (not running after start)"
		return 1
	fi
	touch "$LOCK_FILE" 2>/dev/null || true
	echo "OK"
	return 0
}

stop() {
	printf "Stopping sshd: "
	if is_running; then
		"$KILLALL_BIN" sshd 2>/dev/null || true
		sleep 1
	fi
	rm -f "$LOCK_FILE"
	if is_running; then
		echo "FAIL (still running)"
		return 1
	fi
	echo "OK"
	return 0
}

restart() {
	stop
	start
}

status() {
	if is_running; then
		echo "sshd=running"
		return 0
	fi
	echo "sshd=stopped"
	return 1
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) restart ;;
	status) status ;;
	*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
