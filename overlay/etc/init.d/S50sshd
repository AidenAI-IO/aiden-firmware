#!/bin/sh
# Aiden override: optional sshd startup.

BOOT_CONF=/etc/aiden_boot.conf

if [ -f "$BOOT_CONF" ]; then
	. "$BOOT_CONF"
fi
: "${ENABLE_SSHD:=1}"

# Make sure the ssh-keygen program exists
[ -f /usr/bin/ssh-keygen ] || exit 0

umask 077

start() {
	if [ "$ENABLE_SSHD" != "1" ]; then
		echo "sshd disabled by config (ENABLE_SSHD=$ENABLE_SSHD)"
		return 0
	fi

	chown root:root /var/empty/ 2>/dev/null || true
	/usr/bin/ssh-keygen -A
	printf "Starting sshd: "
	/usr/sbin/sshd
	touch /var/lock/sshd
	echo "OK"
}

stop() {
	printf "Stopping sshd: "
	killall sshd 2>/dev/null || true
	rm -f /var/lock/sshd
	echo "OK"
}

restart() {
	stop
	start
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) restart ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
