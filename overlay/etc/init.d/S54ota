#!/bin/sh
# One-shot OTA health processing. Manual updates run through `ota update`.

OTA_BIN=${OTA_BIN:-/oem/usr/bin/ota}
ENV_RUN_BIN=${ENV_RUN_BIN:-/oem/usr/bin/aiden-env-run}
LOG_PATH=${LOG_PATH:-/var/log/ota/ota.log}
USERDATA_DIR=${USERDATA_DIR:-/userdata}
OTA_STORAGE_DIR=${OTA_STORAGE_DIR:-$USERDATA_DIR/ota}
OTA_STORAGE_DEVICE=${OTA_STORAGE_DEVICE:-/dev/block/by-name/ota}
OTA_STORAGE_FS_TYPE=${OTA_STORAGE_FS_TYPE:-ext4}
SLEEP_BIN=${SLEEP_BIN:-sleep}
WAIT_TIMEOUT=${WAIT_TIMEOUT:-}
USERDATA_REQUIRE_MOUNT=${USERDATA_REQUIRE_MOUNT:-1}
OTA_STORAGE_REQUIRE_MOUNT=${OTA_STORAGE_REQUIRE_MOUNT:-1}
MOUNTS_PATH=${MOUNTS_PATH:-/proc/mounts}
LOCK_DIR=${LOCK_DIR:-/run/ota-health.lock}

prepare_lock_parent() {
    dir="$(dirname "$LOCK_DIR")"
    mkdir -p "$dir" || return 1
    chmod 0755 "$dir"
}

cleanup_lock() {
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

wait_for_existing_path() {
    path="$1"
    description="$2"
    waited=0
    while [ ! -e "$path" ]; do
        if [ -n "$WAIT_TIMEOUT" ] && [ "$waited" -ge "$WAIT_TIMEOUT" ]; then
            echo "[ota] $description unavailable after ${WAIT_TIMEOUT}s: $path" >> "$LOG_PATH"
            return 1
        fi
        echo "[ota] waiting for $path" >> "$LOG_PATH"
        "$SLEEP_BIN" 1
        waited=$((waited + 1))
    done
    return 0
}

path_is_mounted() {
    path="$1"
    expected_device="${2:-}"
    expected_fs_type="${3:-}"
    [ -r "$MOUNTS_PATH" ] || return 1
    mount_record="$(awk -v target="$path" '$2 == target { print $1, $3; exit }' "$MOUNTS_PATH")"
    [ -n "$mount_record" ] || return 1
    set -- $mount_record
    actual_device="$1"
    actual_fs_type="$2"
    if [ -n "$expected_fs_type" ] && [ "$actual_fs_type" != "$expected_fs_type" ]; then
        return 1
    fi
    if [ -n "$expected_device" ] && [ "$actual_device" != "$expected_device" ] && ! [ "$actual_device" -ef "$expected_device" ] 2>/dev/null; then
        return 1
    fi
    return 0
}

wait_for_mount_ready() {
    path="$1"
    description="$2"
    require_mount="$3"
    expected_device="${4:-}"
    expected_fs_type="${5:-}"
    wait_for_existing_path "$path" "$description" || return 1
    [ "$require_mount" = "0" ] && return 0
    waited=0
    while ! path_is_mounted "$path" "$expected_device" "$expected_fs_type"; do
        if [ -n "$WAIT_TIMEOUT" ] && [ "$waited" -ge "$WAIT_TIMEOUT" ]; then
            echo "[ota] $description mount unavailable after ${WAIT_TIMEOUT}s: $path" >> "$LOG_PATH"
            return 1
        fi
        echo "[ota] waiting for $description mount: $path" >> "$LOG_PATH"
        "$SLEEP_BIN" 1
        waited=$((waited + 1))
    done
    return 0
}

wait_for_userdata_ready() {
    wait_for_mount_ready "$USERDATA_DIR" "userdata" "$USERDATA_REQUIRE_MOUNT" "" ""
}

wait_for_ota_storage_ready() {
    wait_for_mount_ready "$OTA_STORAGE_DIR" "OTA storage" "$OTA_STORAGE_REQUIRE_MOUNT" "$OTA_STORAGE_DEVICE" "$OTA_STORAGE_FS_TYPE"
}

wait_for_executable() {
    path="$1"
    description="$2"
    waited=0
    while [ ! -x "$path" ]; do
        if [ -n "$WAIT_TIMEOUT" ] && [ "$waited" -ge "$WAIT_TIMEOUT" ]; then
            echo "[ota] $description unavailable after ${WAIT_TIMEOUT}s: $path" >> "$LOG_PATH"
            return 1
        fi
        echo "[ota] waiting for $path" >> "$LOG_PATH"
        "$SLEEP_BIN" 1
        waited=$((waited + 1))
    done
    return 0
}

run_health_once() {
    mkdir -p "$(dirname "$LOG_PATH")"
    chmod 0755 "$(dirname "$LOG_PATH")"

    wait_for_userdata_ready || return 1
    wait_for_ota_storage_ready || return 1

    wait_for_executable "$ENV_RUN_BIN" "environment launcher" || return 1
    wait_for_executable "$OTA_BIN" "ota binary" || return 1

    echo "[ota] processing pending health" >> "$LOG_PATH"
    "$ENV_RUN_BIN" "$OTA_BIN" health >> "$LOG_PATH" 2>&1
    status="$?"
    echo "[ota] health processing exited with status $status" >> "$LOG_PATH"
    return "$status"
}

run_health_worker() {
    trap cleanup_lock EXIT INT TERM

    if run_health_once; then
        echo "[ota] one-shot health complete" >> "$LOG_PATH"
        exit 0
    else
        status="$?"
        echo "[ota] one-shot health failed with status $status" >> "$LOG_PATH"
        exit "$status"
    fi
}

start() {
    prepare_lock_parent || return 1

    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        echo "ota health already running"
        return 0
    fi

    run_health_worker &
    echo "Started ota health"
    return 0
}

stop() {
    echo "ota health is one-shot"
}

status() {
    if [ -d "$LOCK_DIR" ]; then
        echo "ota=running"
    else
        echo "ota=idle"
    fi
    if [ -f "$LOG_PATH" ]; then
        tail -n 20 "$LOG_PATH"
    fi
}

case "${1:-}" in
    start|restart|reload) start ;;
    stop) stop ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|reload|status}" >&2; exit 1 ;;
esac
