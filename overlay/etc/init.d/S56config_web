#!/bin/sh
# Aiden config web portal. Runs after usb0 + dnsmasq are up.
# Maintains /userdata/agent/agent.toml for the Go agent daemon.

BIN=/oem/usr/bin/config_web
PID_FILE=/run/config_web.pid
CONFIG_PATH=/userdata/agent/agent.toml
WIFI_CONFIG_PATH=/userdata/wpa_supplicant.conf

is_running() {
    pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)"
    case "$exe" in
        "$BIN"|*/config_web) return 0 ;;
    esac
    return 1
}

current_pid() {
    [ -f "$PID_FILE" ] || return
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) return ;;
    esac
    echo "$pid"
}

start() {
    pid="$(current_pid)"
    if is_running "$pid"; then
        echo "config_web already running (pid $pid)"
        return 0
    fi

    if [ ! -x "$BIN" ]; then
        echo "config_web not found at $BIN"
        return 1
    fi

    mkdir -p "$(dirname "$CONFIG_PATH")"

    "$BIN" --config="$CONFIG_PATH" --wifi-config="$WIFI_CONFIG_PATH" &
    child_pid=$!
    echo "$child_pid" > "$PID_FILE"
    sleep 1

    pid="$(current_pid)"
    if ! is_running "$pid"; then
        rm -f "$PID_FILE"
        echo "Failed to start config_web"
        return 1
    fi

    echo "Started config_web (pid $pid)"
}

stop() {
    pid="$(current_pid)"
    if is_running "$pid"; then
        kill "$pid" 2>/dev/null || true
        i=0
        while is_running "$pid" && [ "$i" -lt 5 ]; do
            sleep 1
            i="$((i + 1))"
        done
        is_running "$pid" && kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    echo "Stopped config_web"
}

case "${1:-}" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
