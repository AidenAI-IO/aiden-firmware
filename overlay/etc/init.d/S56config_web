#!/bin/sh
# Aiden config web portal. Runs after usb0 + dnsmasq are up.

BIN=/oem/usr/bin/config_web
PID_FILE=/run/config_web.pid

is_running() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

current_pid() {
    [ -f "$PID_FILE" ] || return
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) return ;;
    esac
    echo "$pid"
}

start() {
    pid="$(current_pid)"
    if is_running "$pid"; then
        echo "config_web already running (pid $pid)"
        return 0
    fi

    if [ ! -x "$BIN" ]; then
        echo "config_web not found at $BIN"
        return 1
    fi

    "$BIN" &
    echo $! > "$PID_FILE"
    echo "Started config_web (pid $!)"
}

stop() {
    pid="$(current_pid)"
    if is_running "$pid"; then
        kill "$pid" 2>/dev/null || true
        i=0
        while is_running "$pid" && [ "$i" -lt 5 ]; do
            sleep 1
            i="$((i + 1))"
        done
        is_running "$pid" && kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    echo "Stopped config_web"
}

case "${1:-}" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
