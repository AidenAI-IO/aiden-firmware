#!/bin/sh
# Aiden frame service watchdog.
# Keeps HDMI frame capture available over /run/frame_service/frame_service.sock when the
# application bundle is deployed. Configure paths in /etc/aiden_frame_service.conf.

CONFIG_FILE=${CONFIG_FILE:-/etc/aiden_frame_service.conf}
AGENT_CONFIG=${AGENT_CONFIG:-/userdata/agent/agent.toml}
BOOT_CONF=/etc/aiden_boot.conf
AIDEN_LOG_HELPER=${AIDEN_LOG_HELPER:-/oem/usr/lib/aiden-log.sh}
[ -r "$AIDEN_LOG_HELPER" ] || AIDEN_LOG_HELPER="$(dirname "$0")/../../oem/usr/lib/aiden-log.sh"
. "$AIDEN_LOG_HELPER"

FRAME_SERVICE_BIN=${FRAME_SERVICE_BIN:-/oem/usr/bin/frame_service}
ENV_RUN_BIN=${ENV_RUN_BIN:-/oem/usr/bin/aiden-env-run}
SOCKET_PATH=${SOCKET_PATH:-/run/frame_service/frame_service.sock}
FRAME_SERVICE_WIDTH=1920
FRAME_SERVICE_HEIGHT=1080
FRAME_SERVICE_WARMUP_FRAMES=
FRAME_SERVICE_ALLOW_UNIFORM_FRAMES=1
FRAME_SERVICE_FORCE_TRIGGER=auto
FRAME_SERVICE_SUBDEV=${FRAME_SERVICE_SUBDEV:-}
FRAME_SERVICE_EDID=auto
FRAME_SERVICE_TC358743_EDID=/oem/usr/share/aiden/edid/hdmi_1080p30_cta.hex
FRAME_SERVICE_TC358743_HPD_LOW_SECONDS=2
FRAME_SERVICE_TC358743_SETTLE_SECONDS=5
LOG_PATH=${LOG_PATH:-/var/log/frame_service/frame_service.log}
PID_FILE=${PID_FILE:-/run/frame_service/frame_service.pid}
WATCHDOG_PID_FILE=${WATCHDOG_PID_FILE:-/run/frame_service/frame_service_watchdog.pid}

if [ -f "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi
if [ -f "$BOOT_CONF" ]; then
    . "$BOOT_CONF"
fi
: "${ENABLE_FRAME_SERVICE:=1}"

supervisor_log() {
    level="$1"
    event="$2"
    shift 2
    aiden_log_to_file "$LOG_PATH" "$level" frame_service supervisor "$event" "$*"
}

is_running() {
    pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

pid_matches_service() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$FRAME_SERVICE_BIN"*"--socket"*"$SOCKET_PATH"*) return 0 ;;
        *"frame_service"*"--socket"*"$SOCKET_PATH"*) return 0 ;;
        *) return 1 ;;
    esac
}

pid_matches_watchdog() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$0"*|*"S52frame_service"*) return 0 ;;
        *) return 1 ;;
    esac
}

service_pid() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_service "$pid"; then
            echo "$pid"
        fi
    fi
}

watchdog_pid() {
    if [ -f "$WATCHDOG_PID_FILE" ]; then
        pid="$(cat "$WATCHDOG_PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_watchdog "$pid"; then
            echo "$pid"
        fi
    fi
}

detect_hdmi_subdev() {
    for name_file in /sys/class/video4linux/v4l-subdev*/name; do
        [ -r "$name_file" ] || continue
        name="$(cat "$name_file" 2>/dev/null)"
        case "$name" in
            *rk628-csi*|*tc358743*)
                node="$(basename "$(dirname "$name_file")")"
                echo "/dev/$node"
                return 0
                ;;
        esac
    done
    return 1
}

hdmi_subdev_name() {
    subdev="$1"
    [ -n "$subdev" ] || return 1
    node="$(basename "$subdev")"
    name_file="/sys/class/video4linux/$node/name"
    [ -r "$name_file" ] || return 1
    cat "$name_file" 2>/dev/null
}

resolve_force_trigger() {
    requested="$1"
    subdev="$2"

    case "$requested" in
        0|1)
            echo "$requested"
            ;;
        auto|"")
            name="$(hdmi_subdev_name "$subdev")"
            case "$name" in
                *tc358743*) echo 1 ;;
                *rk628-csi*) echo 0 ;;
                *) echo 0 ;;
            esac
            ;;
        *)
            echo 0
            ;;
    esac
}

resolve_edid() {
    requested="$1"
    subdev="$2"

    case "$requested" in
        auto|"")
            name="$(hdmi_subdev_name "$subdev")"
            case "$name" in
                *tc358743*) echo "$FRAME_SERVICE_TC358743_EDID" ;;
                *) echo "" ;;
            esac
            ;;
        *)
            echo "$requested"
            ;;
    esac
}

configured_keep_streamon() {
    [ -r "$AGENT_CONFIG" ] || {
        echo 0
        return
    }
    value="$(awk '
        /^\[frame_service\][[:space:]]*$/ { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && $1 == "keep_streamon" && $2 == "=" { print $3; exit }
    ' "$AGENT_CONFIG")"
    case "$value" in
        true|1) echo 1 ;;
        *) echo 0 ;;
    esac
}

prepare_tc358743_edid() {
    subdev="$1"
    edid="$2"
    name="$(hdmi_subdev_name "$subdev")"

    case "$name" in
        *tc358743*) ;;
        *) return 0 ;;
    esac

    if [ ! -r "$edid" ]; then
        supervisor_log ERROR edid_missing "TC358743 EDID not readable: $edid"
        return 1
    fi
    if ! command -v v4l2-ctl >/dev/null 2>&1; then
        supervisor_log ERROR edid_tool_missing "v4l2-ctl is required for TC358743 HPD renegotiation"
        return 1
    fi

    supervisor_log INFO edid_renegotiation \
        "holding TC358743 HPD low for ${FRAME_SERVICE_TC358743_HPD_LOW_SECONDS}s before loading $edid"
    if ! v4l2-ctl -d "$subdev" --clear-edid=pad=0; then
        supervisor_log ERROR edid_clear_failed "device=$subdev"
        return 1
    fi
    sleep "$FRAME_SERVICE_TC358743_HPD_LOW_SECONDS"
    if ! v4l2-ctl -d "$subdev" \
        --set-edid="pad=0,file=$edid" --fix-edid-checksums; then
        supervisor_log ERROR edid_set_failed "device=$subdev path=$edid"
        return 1
    fi
    sleep "$FRAME_SERVICE_TC358743_SETTLE_SECONDS"
    return 0
}

start() {
    if [ "$ENABLE_FRAME_SERVICE" != "1" ]; then
        echo "frame_service disabled by config (ENABLE_FRAME_SERVICE=$ENABLE_FRAME_SERVICE)"
        return 0
    fi

    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        echo "frame_service watchdog already running (pid $wpid)"
        return 0
    fi

    mkdir -p "$(dirname "$SOCKET_PATH")" "$(dirname "$LOG_PATH")"
    chmod 0755 "$(dirname "$SOCKET_PATH")" "$(dirname "$LOG_PATH")"
    rm -f "$SOCKET_PATH"

    (
        trap 'exit 0' INT TERM
        bridge_prepared=0
        while true; do
            if [ ! -x "$FRAME_SERVICE_BIN" ]; then
                supervisor_log WARN binary_wait "waiting for $FRAME_SERVICE_BIN"
                sleep 5
                continue
            fi

            set -- --socket "$SOCKET_PATH"
            if [ -n "$FRAME_SERVICE_WIDTH" ]; then
                set -- "$@" --width "$FRAME_SERVICE_WIDTH"
            fi
            if [ -n "$FRAME_SERVICE_HEIGHT" ]; then
                set -- "$@" --height "$FRAME_SERVICE_HEIGHT"
            fi
            if [ -n "$FRAME_SERVICE_WARMUP_FRAMES" ]; then
                set -- "$@" --warmup-frames "$FRAME_SERVICE_WARMUP_FRAMES"
            fi
            if [ "$(configured_keep_streamon)" = "1" ]; then
                set -- "$@" --keep-streamon
            else
                set -- "$@" --pause-between-captures
            fi
            if [ "$FRAME_SERVICE_ALLOW_UNIFORM_FRAMES" = "1" ]; then
                set -- "$@" --allow-uniform-frames
            else
                set -- "$@" --reject-uniform-frames
            fi
            subdev="$FRAME_SERVICE_SUBDEV"
            if [ -z "$subdev" ]; then
                subdev="$(detect_hdmi_subdev)"
            fi
            if [ -z "$subdev" ]; then
                supervisor_log WARN bridge_wait "waiting for RK628D or TC358743 subdevice"
                sleep 2
                continue
            fi
            if [ -n "$subdev" ]; then
                set -- "$@" --subdev "$subdev"
            fi
            force_trigger="$(resolve_force_trigger "$FRAME_SERVICE_FORCE_TRIGGER" "$subdev")"
            edid="$(resolve_edid "$FRAME_SERVICE_EDID" "$subdev")"
            bridge_name="$(hdmi_subdev_name "$subdev")"
            case "$bridge_name" in
                *tc358743*)
                    if [ "$bridge_prepared" != "1" ] && [ "$force_trigger" = "1" ]; then
                        if ! prepare_tc358743_edid "$subdev" "$edid"; then
                            sleep 2
                            continue
                        fi
                        bridge_prepared=1
                    fi
                    if [ "$bridge_prepared" = "1" ]; then
                        force_trigger=0
                    fi
                    ;;
            esac
            if [ "$force_trigger" = "1" ]; then
                set -- "$@" --force-trigger
            else
                set -- "$@" --no-force-trigger
            fi
            if [ -n "$edid" ]; then
                set -- "$@" --edid "$edid"
            fi

            supervisor_log INFO process_starting "starting $FRAME_SERVICE_BIN $*"
            "$ENV_RUN_BIN" "$FRAME_SERVICE_BIN" "$@" >> "$LOG_PATH" 2>&1 &
            child="$!"
            echo "$child" > "$PID_FILE"
            wait "$child"
            status="$?"
            rm -f "$PID_FILE" "$SOCKET_PATH"
            supervisor_log WARN process_exited \
                "exited with status $status; restarting in 2s"
            sleep 2
        done
    ) </dev/null >> "$LOG_PATH" 2>&1 &
    echo "$!" > "$WATCHDOG_PID_FILE"
    echo "Started frame_service"
}

stop() {
    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        kill "$wpid" 2>/dev/null || true
    fi
    rm -f "$WATCHDOG_PID_FILE"

    spid="$(service_pid)"
    if is_running "$spid"; then
        kill "$spid" 2>/dev/null || true
        i=0
        while is_running "$spid" && [ "$i" -lt 5 ]; do
            sleep 1
            i="$((i + 1))"
        done
        if is_running "$spid"; then
            kill -9 "$spid" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE" "$SOCKET_PATH"
    echo "Stopped frame_service"
}

status() {
    wpid="$(watchdog_pid)"
    spid="$(service_pid)"
    if is_running "$wpid"; then
        echo "watchdog=running pid=$wpid"
    else
        echo "watchdog=stopped"
    fi
    if is_running "$spid"; then
        echo "frame_service=running pid=$spid socket=$SOCKET_PATH"
    else
        echo "frame_service=stopped"
    fi
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
