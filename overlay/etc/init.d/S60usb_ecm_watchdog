#!/bin/sh
# Aiden USB ECM connectivity watchdog.
#
# After iPhone lock screen (and occasionally after Mac sleep), USB ECM enters
# a "half-up" state: the gadget UDC is still configured, usb0 is UP, but the
# host's IP stack stops responding to ARP. This script probes ECM connectivity
# with arping and resets the ECM function when the host becomes unreachable,
# forcing the host to re-enumerate without affecting HID functions.

GADGET_UDC=/sys/kernel/config/usb_gadget/aiden_hid/UDC
UDC_NAME=ffb00000.usb
UDC_STATE=/sys/class/udc/${UDC_NAME}/state
GADGET_CONFIG=/sys/kernel/config/usb_gadget/aiden_hid/configs/c.1
GADGET_ECM_FUNC=/sys/kernel/config/usb_gadget/aiden_hid/functions/ecm.usb0
LOG_FILE=/var/log/aiden_usb_ecm_watchdog.log
PID_FILE=/run/aiden_usb_ecm_watchdog.pid
LEASE_FILE=/tmp/dnsmasq.leases

PROBE_INTERVAL=5       # probe ECM connectivity every N seconds
PROBE_FAIL_THRESHOLD=2 # reset after N consecutive probe failures
ARPING_COUNT=2         # ARP requests per probe
ARPING_TIMEOUT=2       # seconds to wait for ARP reply
COOLDOWN=30            # minimum seconds between resets

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

is_configured() {
    state=$(cat "$UDC_STATE" 2>/dev/null)
    [ "$state" = "configured" ]
}

get_ecm_hosts() {
    {
        awk '$3 ~ /^192\.168\.42\./ && $3 != "192.168.42.1" {print $3}' "$LEASE_FILE" 2>/dev/null
        awk '$1 ~ /^192\.168\.42\./ && $1 != "192.168.42.1" && $6 == "usb0" {print $1}' /proc/net/arp 2>/dev/null
    } | sort -u
}

probe_ecm_connectivity() {
    hosts=$(get_ecm_hosts)
    [ -z "$hosts" ] && return 1

    for host in $hosts; do
        if arping -q -c "$ARPING_COUNT" -w "$ARPING_TIMEOUT" -I usb0 "$host" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

reset_ecm() {
    log "resetting ECM function"

    if ! rm "$GADGET_CONFIG/ecm.usb0" 2>>"$LOG_FILE"; then
        log "ECM unlink failed"
        return 1
    fi

    sleep 1

    if ! ln -s "$GADGET_ECM_FUNC" "$GADGET_CONFIG/ecm.usb0" 2>>"$LOG_FILE"; then
        log "ECM relink failed; UDC state may be broken"
        return 1
    fi

    # On this kernel, unlinking ECM unbinds the entire UDC. Re-bind explicitly.
    cur_udc=$(cat "$GADGET_UDC" 2>/dev/null)
    if [ -z "$cur_udc" ]; then
        if ! echo "$UDC_NAME" > "$GADGET_UDC" 2>>"$LOG_FILE"; then
            log "UDC rebind failed after ECM relink"
            return 1
        fi
    fi

    log "ECM reset complete (udc state=$(cat "$UDC_STATE" 2>/dev/null))"
}

watchdog_main() {
    fail_count=0
    last_reset=0

    while :; do
        sleep "$PROBE_INTERVAL"
        now=$(date +%s)

        if ! is_configured; then
            fail_count=0
            continue
        fi

        if probe_ecm_connectivity; then
            fail_count=0
            continue
        fi

        fail_count=$((fail_count + 1))
        log "ECM probe failed ($fail_count/$PROBE_FAIL_THRESHOLD)"

        if [ $fail_count -ge $PROBE_FAIL_THRESHOLD ]; then
            if [ $((now - last_reset)) -lt $COOLDOWN ]; then
                continue
            fi

            log "ECM stall detected — resetting"
            if reset_ecm; then
                last_reset=$now
            fi
            fail_count=0
        fi
    done
}

start() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "aiden_usb_ecm_watchdog already running (pid $pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    mkdir -p "$(dirname "$LOG_FILE")"
    log "starting (interval=${PROBE_INTERVAL}s threshold=${PROBE_FAIL_THRESHOLD} cooldown=${COOLDOWN}s)"
    watchdog_main &
    pid=$!
    echo "$pid" > "$PID_FILE"
    echo "aiden_usb_ecm_watchdog started (pid $pid)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    log "stopped"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                echo "running (pid $pid)"
                exit 0
            fi
        fi
        echo "stopped"
        exit 1
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
