#!/bin/sh
# Aiden USB gadget connectivity watchdog.
#
# After iPhone lock screen (and occasionally after Mac sleep), USB can enter
# a "half-up" state: the gadget UDC is still configured and usb0 may be UP, but
# the host-side composite/HID session is stale. Resetting only the ECM function
# can leave iOS with a stale external-keyboard session where plain keys work but
# modifiers/shortcuts are ignored. This watchdog refreshes the whole composite
# gadget after host configuration changes and when ECM connectivity stalls.

GADGET_UDC=/sys/kernel/config/usb_gadget/aiden_hid/UDC
UDC_NAME=ffb00000.usb
UDC_STATE=/sys/class/udc/${UDC_NAME}/state
LOG_FILE=/var/log/aiden_usb_ecm_watchdog.log
PID_FILE=/run/aiden_usb_ecm_watchdog.pid
LEASE_FILE=/tmp/dnsmasq.leases
USB0_ADDR=192.168.42.1
USB0_NETMASK=255.255.255.0

PROBE_INTERVAL=5       # probe ECM connectivity every N seconds
PROBE_FAIL_THRESHOLD=2 # reset after N consecutive probe failures
ARPING_COUNT=2         # ARP requests per probe
ARPING_TIMEOUT=2       # seconds to wait for ARP reply
COOLDOWN=30            # minimum seconds between resets
HOST_CONFIG_REFRESH_DELAY=2 # seconds after a new configured event before refreshing iOS HID session

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

is_configured() {
    state=$(read_udc_state)
    [ "$state" = "configured" ]
}

read_udc_state() {
    cat "$UDC_STATE" 2>/dev/null
}

get_ecm_hosts() {
    {
        awk '$3 ~ /^192\.168\.42\./ && $3 != "192.168.42.1" {print $3}' "$LEASE_FILE" 2>/dev/null
        awk '$1 ~ /^192\.168\.42\./ && $1 != "192.168.42.1" && $6 == "usb0" {print $1}' /proc/net/arp 2>/dev/null
    } | sort -u
}

probe_ecm_connectivity() {
    hosts=$(get_ecm_hosts)
    [ -z "$hosts" ] && return 1

    for host in $hosts; do
        if arping -q -c "$ARPING_COUNT" -w "$ARPING_TIMEOUT" -I usb0 "$host" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

reset_composite() {
    reason="$1"
    log "resetting USB composite gadget: $reason"

    if [ ! -f "$GADGET_UDC" ]; then
        log "UDC control file missing: $GADGET_UDC"
        return 1
    fi

    cur_udc=$(cat "$GADGET_UDC" 2>/dev/null)
    if [ -n "$cur_udc" ]; then
        if ! echo "" > "$GADGET_UDC" 2>>"$LOG_FILE"; then
            log "UDC unbind failed"
            return 1
        fi
    fi

    sleep 1

    if ! echo "$UDC_NAME" > "$GADGET_UDC" 2>>"$LOG_FILE"; then
        log "UDC rebind failed"
        return 1
    fi

    configured=0
    for i in $(seq 1 10); do
        if is_configured; then
            configured=1
            break
        fi
        sleep 1
    done

    if [ "$configured" -ne 1 ]; then
        log "UDC did not reach configured state after composite reset (udc state=$(cat "$UDC_STATE" 2>/dev/null))"
        return 1
    fi

    if [ -d /sys/class/net/usb0 ]; then
        ifconfig usb0 "$USB0_ADDR" netmask "$USB0_NETMASK" up 2>>"$LOG_FILE" || log "usb0 ifconfig failed after composite reset"
    fi

    log "USB composite reset complete (udc state=$(cat "$UDC_STATE" 2>/dev/null))"
}

watchdog_main() {
    ecm_fail_count=0
    last_reset=0
    last_udc_state=$(read_udc_state)
    configured_refresh_pending=0
    configured_refresh_at=0

    while :; do
        sleep "$PROBE_INTERVAL"
        now=$(date +%s)
        state=$(read_udc_state)

        if [ "$state" != "$last_udc_state" ]; then
            log "UDC state changed: ${last_udc_state:-unknown} -> ${state:-unknown}"
            if [ "$state" = "configured" ]; then
                configured_refresh_pending=1
                configured_refresh_at=$((now + HOST_CONFIG_REFRESH_DELAY))
            fi
            last_udc_state="$state"
        fi

        if [ "$state" != "configured" ]; then
            ecm_fail_count=0
            continue
        fi

        if [ "$configured_refresh_pending" -eq 1 ] && [ "$now" -ge "$configured_refresh_at" ]; then
            if [ $((now - last_reset)) -ge $COOLDOWN ]; then
                log "host configured; refreshing composite gadget to clear stale HID session"
                last_reset=$now
                configured_refresh_pending=0
                if reset_composite "host configured"; then
                    ecm_fail_count=0
                    last_udc_state=$(read_udc_state)
                fi
                continue
            fi
        fi

        if probe_ecm_connectivity; then
            ecm_fail_count=0
            continue
        fi

        ecm_fail_count=$((ecm_fail_count + 1))
        log "ECM probe failed ($ecm_fail_count/$PROBE_FAIL_THRESHOLD)"

        if [ $ecm_fail_count -ge $PROBE_FAIL_THRESHOLD ]; then
            if [ $((now - last_reset)) -lt $COOLDOWN ]; then
                continue
            fi

            log "ECM stall detected; resetting composite gadget"
            # Start the cooldown window from the attempt itself: even if the
            # reset fails, we don't want to hammer the gadget every interval.
            last_reset=$now
            if reset_composite "ECM stall"; then
                ecm_fail_count=0
            fi
        fi
    done
}

start() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "aiden_usb_ecm_watchdog already running (pid $pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    mkdir -p "$(dirname "$LOG_FILE")"
    log "starting (interval=${PROBE_INTERVAL}s threshold=${PROBE_FAIL_THRESHOLD} cooldown=${COOLDOWN}s)"
    "$0" _watchdog </dev/null >/dev/null 2>&1 &
    pid=$!
    echo "$pid" > "$PID_FILE"
    echo "aiden_usb_ecm_watchdog started (pid $pid)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    log "stopped"
}

case "$1" in
    _watchdog) watchdog_main ;;
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    refresh) reset_composite "manual refresh" ;;
    status)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                echo "running (pid $pid)"
                exit 0
            fi
        fi
        echo "stopped"
        exit 1
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
