#!/bin/sh
# Aiden USB gadget connectivity watchdog.
#
# After iPhone lock screen (and occasionally after Mac sleep), USB can enter
# a "half-up" state: the gadget UDC is still configured and usb0 may be UP, but
# the host-side composite/HID session is stale. Resetting only the ECM function
# can leave iOS with a stale external-keyboard session where plain keys work but
# modifiers/shortcuts are ignored. This watchdog keeps diagnostics for host
# configuration changes, exposes an explicit full refresh command for stale HID
# sessions, and automatically refreshes the composite gadget only when ECM
# connectivity stalls.

GADGET_UDC=/sys/kernel/config/usb_gadget/aiden_hid/UDC
GADGET_DIR=/sys/kernel/config/usb_gadget/aiden_hid
HID_KEYBOARD_FUNC=${GADGET_DIR}/functions/hid.usb0
UDC_NAME=ffb00000.usb
UDC_STATE=/sys/class/udc/${UDC_NAME}/state
LOG_FILE=/var/log/aiden_usb_ecm_watchdog.log
PID_FILE=/run/aiden_usb_ecm_watchdog.pid
STATE_FILE=/run/aiden_usb_ecm_watchdog.state
LEASE_FILE=/tmp/dnsmasq.leases
GADGET_SWITCH_LOCK_DIR=/run/aiden_dynamic_keyboard.lock
PLANNED_SWITCH_GRACE_FILE=/run/aiden_dynamic_keyboard.grace
IOS_SESSION_CONTROL=/etc/init.d/S50ios_hid_session
IOS_SESSION_READY_FILE=/run/aiden_ios_hid_session.ready
AGENT_TOML=/userdata/agent/agent.toml
USB0_ADDR=192.168.42.1
USB0_NETMASK=255.255.255.0

PROBE_INTERVAL=5       # probe ECM connectivity every N seconds
PROBE_FAIL_THRESHOLD=2 # reset after N consecutive probe failures
ARPING_COUNT=2         # ARP requests per probe
ARPING_TIMEOUT=2       # seconds to wait for ARP reply
COOLDOWN=30            # minimum seconds between resets

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

is_configured() {
    state=$(read_udc_state)
    [ "$state" = "configured" ]
}

read_udc_state() {
    cat "$UDC_STATE" 2>/dev/null
}

read_gadget_udc() {
    cat "$GADGET_UDC" 2>/dev/null
}

read_hid_keyboard_field() {
    cat "$HID_KEYBOARD_FUNC/$1" 2>/dev/null || printf '?'
}

describe_hid_keyboard() {
    printf 'protocol=%s subclass=%s report_length=%s' \
        "$(read_hid_keyboard_field protocol)" \
        "$(read_hid_keyboard_field subclass)" \
        "$(read_hid_keyboard_field report_length)"
}

get_ecm_hosts() {
    {
        awk '$3 ~ /^192\.168\.42\./ && $3 != "192.168.42.1" {print $3}' "$LEASE_FILE" 2>/dev/null
        awk '$1 ~ /^192\.168\.42\./ && $1 != "192.168.42.1" && $6 == "usb0" {print $1}' /proc/net/arp 2>/dev/null
    } | sort -u
}

describe_ecm_hosts() {
    hosts=$(get_ecm_hosts | tr '\n' ' ')
    [ -n "$hosts" ] && printf '%s' "$hosts" || printf 'none'
}

describe_usb0() {
    if [ ! -d /sys/class/net/usb0 ]; then
        printf 'absent'
        return
    fi
    flags=$(cat /sys/class/net/usb0/flags 2>/dev/null || printf '?')
    addr=$(ifconfig usb0 2>/dev/null | awk '/inet addr:/ {sub(/^addr:/, "", $2); print $2; exit}')
    [ -n "$addr" ] || addr=none
    printf 'present flags=%s addr=%s' "$flags" "$addr"
}

write_refresh_state() {
    reason="$1"
    result="$2"
    started_at="$3"
    detail="$4"
    {
        printf 'last_refresh_epoch=%s\n' "$(date +%s)"
        printf 'last_refresh_reason=%s\n' "$reason"
        printf 'last_refresh_result=%s\n' "$result"
        printf 'last_refresh_started_epoch=%s\n' "$started_at"
        printf 'last_refresh_detail=%s\n' "$detail"
        printf 'udc_state=%s\n' "$(read_udc_state)"
        printf 'gadget_udc=%s\n' "$(read_gadget_udc)"
        printf 'hid_keyboard_%s\n' "$(describe_hid_keyboard)"
        printf 'usb0=%s\n' "$(describe_usb0)"
        printf 'ecm_hosts=%s\n' "$(describe_ecm_hosts)"
    } > "$STATE_FILE"
}

log_snapshot() {
    label="$1"
    log "$label: udc_state=$(read_udc_state) gadget_udc=$(read_gadget_udc) hid_keyboard=($(describe_hid_keyboard)) usb0=($(describe_usb0)) ecm_hosts=($(describe_ecm_hosts))"
}

probe_ecm_connectivity() {
    hosts=$(get_ecm_hosts)
    [ -z "$hosts" ] && return 1

    for host in $hosts; do
        if arping -q -c "$ARPING_COUNT" -w "$ARPING_TIMEOUT" -I usb0 "$host" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

read_planned_switch_grace_until() {
    planned_grace_until=$(cat "$PLANNED_SWITCH_GRACE_FILE" 2>/dev/null || true)
    case "$planned_grace_until" in
        ''|*[!0-9]*) planned_grace_until=0 ;;
    esac
    printf '%s\n' "$planned_grace_until"
}

planned_switch_grace_active() {
    planned_grace_until=$(read_planned_switch_grace_until)
    planned_grace_now=$(date +%s)
    [ "$planned_grace_until" -gt "$planned_grace_now" ]
}

is_ios_absolute_mode() {
    [ -f "$AGENT_TOML" ] || return 0
    line=$(grep -E '^[[:space:]]*pointer_mode[[:space:]]*=' "$AGENT_TOML" | tail -n1)
    case "$line" in
        *\"touchscreen\"*|*\'touchscreen\'*|*touchscreen*) return 1 ;;
        *) return 0 ;;
    esac
}

can_refresh_ios_hid_session() {
    is_ios_absolute_mode && [ -x "$IOS_SESSION_CONTROL" ]
}

acquire_gadget_switch_lock() {
    if mkdir "$GADGET_SWITCH_LOCK_DIR" 2>/dev/null; then
        echo "$$" > "$GADGET_SWITCH_LOCK_DIR/pid"
        return 0
    fi

    owner=$(cat "$GADGET_SWITCH_LOCK_DIR/pid" 2>/dev/null || true)
    case "$owner" in
        ''|*[!0-9]*) ;;
        *)
            if ! kill -0 "$owner" 2>/dev/null; then
                rm -f "$GADGET_SWITCH_LOCK_DIR/pid"
                rmdir "$GADGET_SWITCH_LOCK_DIR" 2>/dev/null || true
                if mkdir "$GADGET_SWITCH_LOCK_DIR" 2>/dev/null; then
                    echo "$$" > "$GADGET_SWITCH_LOCK_DIR/pid"
                    return 0
                fi
            fi
            ;;
    esac

    log "USB composite reset deferred; gadget switch lock is busy (owner=${owner:-unknown})"
    return 1
}

release_gadget_switch_lock() {
    rm -f "$GADGET_SWITCH_LOCK_DIR/pid"
    rmdir "$GADGET_SWITCH_LOCK_DIR" 2>/dev/null || true
}

reset_composite_locked() {
    reason="$1"
    started_at=$(date +%s)
    log "resetting USB composite gadget: $reason"
    log_snapshot "before reset ($reason)"
    write_refresh_state "$reason" "started" "$started_at" "reset started"

    if [ ! -f "$GADGET_UDC" ]; then
        log "UDC control file missing: $GADGET_UDC"
        write_refresh_state "$reason" "failed" "$started_at" "UDC control file missing"
        return 1
    fi

    cur_udc=$(cat "$GADGET_UDC" 2>/dev/null)
    if [ -n "$cur_udc" ]; then
        if ! echo "" > "$GADGET_UDC" 2>>"$LOG_FILE"; then
            log "UDC unbind failed"
            write_refresh_state "$reason" "failed" "$started_at" "UDC unbind failed"
            return 1
        fi
    fi

    sleep 1

    if ! echo "$UDC_NAME" > "$GADGET_UDC" 2>>"$LOG_FILE"; then
        log "UDC rebind failed"
        write_refresh_state "$reason" "failed" "$started_at" "UDC rebind failed"
        return 1
    fi

    configured=0
    for i in $(seq 1 10); do
        if is_configured; then
            configured=1
            break
        fi
        sleep 1
    done

    if [ "$configured" -ne 1 ]; then
        log "UDC did not reach configured state after composite reset (udc state=$(cat "$UDC_STATE" 2>/dev/null))"
        write_refresh_state "$reason" "failed" "$started_at" "UDC did not reach configured"
        return 1
    fi

    if [ -d /sys/class/net/usb0 ]; then
        ifconfig usb0 "$USB0_ADDR" netmask "$USB0_NETMASK" up 2>>"$LOG_FILE" || log "usb0 ifconfig failed after composite reset"
    fi

    finished_at=$(date +%s)
    duration=$((finished_at - started_at))
    log "USB composite reset complete (reason=$reason duration=${duration}s udc state=$(cat "$UDC_STATE" 2>/dev/null))"
    log_snapshot "after reset ($reason)"
    write_refresh_state "$reason" "ok" "$started_at" "duration=${duration}s"
}

refresh_ios_hid_session() {
    reason="$1"
    started_at=$(date +%s)
    log "refreshing iOS HID session through pointer-free profile: $reason"
    log_snapshot "before iOS HID session refresh ($reason)"
    write_refresh_state "$reason" "started" "$started_at" "pointer-free -> normal refresh started"

    if ! "$IOS_SESSION_CONTROL" refresh >>"$LOG_FILE" 2>&1; then
        log "iOS HID session refresh failed: $reason"
        write_refresh_state "$reason" "failed" "$started_at" "pointer-free -> normal refresh failed"
        return 1
    fi

    finished_at=$(date +%s)
    duration=$((finished_at - started_at))
    log "iOS HID session refresh complete (reason=$reason duration=${duration}s)"
    log_snapshot "after iOS HID session refresh ($reason)"
    write_refresh_state "$reason" "ok" "$started_at" "pointer-free -> normal duration=${duration}s"
}

reset_composite() {
    reason="$1"
    if can_refresh_ios_hid_session; then
        if planned_switch_grace_active; then
            log "iOS HID session refresh skipped during planned profile switch grace (reason=$reason until=$planned_grace_until)"
            [ "$reason" = "manual refresh" ] && return 0
            return 2
        fi
        refresh_ios_hid_session "$reason"
        return $?
    fi
    acquire_gadget_switch_lock || return 1
    if planned_switch_grace_active; then
        log "USB composite reset skipped during planned profile switch grace (reason=$reason until=$planned_grace_until)"
        release_gadget_switch_lock
        # HIDDevice uses the refresh command after an ENXIO open. Treat a
        # planned-switch skip as successful so it waits briefly and retries the
        # recreated node instead of failing the tool or forcing another reset.
        [ "$reason" = "manual refresh" ] && return 0
        return 2
    fi
    if reset_composite_locked "$reason"; then
        result=0
    else
        result=$?
    fi
    release_gadget_switch_lock
    return "$result"
}

watchdog_main() {
    ecm_fail_count=0
    last_reset=0
    last_udc_state=$(read_udc_state)
    last_planned_grace_until=0

    log_snapshot "watchdog loop start"
    if [ "$last_udc_state" = "configured" ]; then
        if can_refresh_ios_hid_session && [ ! -f "$IOS_SESSION_READY_FILE" ]; then
            log "watchdog found an uninitialized iOS HID session; applying pointer-free bootstrap"
            reset_composite "watchdog startup" || true
        else
            log "watchdog started while UDC already configured; leaving HID session intact"
        fi
    fi

    while :; do
        sleep "$PROBE_INTERVAL"
        now=$(date +%s)
        state=$(read_udc_state)

        if [ "$state" != "$last_udc_state" ]; then
            log "UDC state changed: ${last_udc_state:-unknown} -> ${state:-unknown}"
            if [ "$state" = "configured" ]; then
                if can_refresh_ios_hid_session && [ ! -f "$IOS_SESSION_READY_FILE" ] && ! planned_switch_grace_active; then
                    log "new iOS host session configured; applying pointer-free bootstrap"
                    reset_composite "host configured" || true
                else
                    log "UDC configured transition observed; leaving HID session intact"
                fi
            elif can_refresh_ios_hid_session && ! planned_switch_grace_active; then
                rm -f "$IOS_SESSION_READY_FILE"
                log "iOS host session detached; cleared bootstrap readiness"
            fi
            last_udc_state="$state"
        fi

        if [ "$state" != "configured" ]; then
            if [ "$ecm_fail_count" -ne 0 ]; then
                log "UDC not configured; clearing ECM failure count"
            fi
            ecm_fail_count=0
            continue
        fi

        if planned_switch_grace_active; then
            if [ "$planned_grace_until" != "$last_planned_grace_until" ]; then
                log "planned profile switch grace active until $planned_grace_until; skipping ECM probe"
            fi
            if [ "$ecm_fail_count" -ne 0 ]; then
                log "planned profile switch grace active; clearing ECM failure count"
            fi
            ecm_fail_count=0
            last_planned_grace_until=$planned_grace_until
            continue
        fi
        if [ "$last_planned_grace_until" -ne 0 ]; then
            log "planned profile switch grace ended; resuming ECM probes"
            last_planned_grace_until=0
        fi

        if probe_ecm_connectivity; then
            if [ "$ecm_fail_count" -ne 0 ]; then
                log "ECM probe recovered after $ecm_fail_count failure(s)"
            fi
            ecm_fail_count=0
            continue
        fi

        # The profile switch may begin while arping is already in flight. Check
        # the grace marker again before counting that expected interruption.
        if planned_switch_grace_active; then
            log "ECM probe interrupted by planned profile switch; ignoring failure until $planned_grace_until"
            ecm_fail_count=0
            last_planned_grace_until=$planned_grace_until
            continue
        fi

        ecm_fail_count=$((ecm_fail_count + 1))
        log "ECM probe failed ($ecm_fail_count/$PROBE_FAIL_THRESHOLD hosts=$(describe_ecm_hosts))"

        if [ $ecm_fail_count -ge $PROBE_FAIL_THRESHOLD ]; then
            if [ $((now - last_reset)) -lt $COOLDOWN ]; then
                continue
            fi

            log "ECM stall detected; resetting composite gadget"
            if reset_composite "ECM stall"; then
                last_reset=$now
                ecm_fail_count=0
            else
                reset_result=$?
                if [ "$reset_result" -eq 2 ]; then
                    # A profile switch began after the final probe check. This
                    # is not a failed reset attempt and must not start cooldown.
                    ecm_fail_count=0
                else
                    # Start cooldown from a real attempt even when it fails so
                    # a persistent fault cannot hammer the gadget every loop.
                    last_reset=$now
                fi
            fi
        fi
    done
}

start() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "aiden_usb_ecm_watchdog already running (pid $pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    mkdir -p "$(dirname "$LOG_FILE")"
    log "starting (interval=${PROBE_INTERVAL}s threshold=${PROBE_FAIL_THRESHOLD} cooldown=${COOLDOWN}s)"
    log_snapshot "start command"
    "$0" _watchdog </dev/null >/dev/null 2>&1 &
    pid=$!
    echo "$pid" > "$PID_FILE"
    echo "aiden_usb_ecm_watchdog started (pid $pid)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    log "stopped"
}

case "$1" in
    _watchdog) watchdog_main ;;
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    refresh) reset_composite "manual refresh" ;;
    snapshot) log_snapshot "manual snapshot"; cat "$STATE_FILE" 2>/dev/null || true ;;
    status)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                echo "running (pid $pid)"
                log_snapshot "status command"
                cat "$STATE_FILE" 2>/dev/null || true
                exit 0
            fi
        fi
        echo "stopped"
        exit 1
        ;;
    *) echo "Usage: $0 {start|stop|restart|status|refresh|snapshot}" >&2; exit 1 ;;
esac
