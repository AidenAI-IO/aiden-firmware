#!/bin/sh
#
# iOS keyboard + pointer routing experiment.
#
# Keep the proven E11 keyboard-only baseline and add exactly one absolute mouse
# pointer function. Consumer Control, Apple vendor HID, and CDC ECM functions
# are intentionally omitted. Build the complete descriptor tree, wait for it
# to settle, and bind the UDC exactly once with keyboard first.
#

GADGET_DIR=/sys/kernel/config/usb_gadget/aiden_hid
USB_MODE_PATH=/proc/device-tree/usbdrd/usb@ffb00000/dr_mode

cleanup_gadget() {
	[ -d "$GADGET_DIR" ] || return

	echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	rm -f "$GADGET_DIR"/configs/c.1/hid.* 2>/dev/null
	rm -f "$GADGET_DIR"/configs/c.1/ecm.* 2>/dev/null
	rmdir "$GADGET_DIR"/functions/hid.usb0 2>/dev/null
	rmdir "$GADGET_DIR"/functions/hid.usb1 2>/dev/null
	rmdir "$GADGET_DIR"/functions/hid.usb2 2>/dev/null
	rmdir "$GADGET_DIR"/functions/hid.usb3 2>/dev/null
	rmdir "$GADGET_DIR"/functions/hid.usb4 2>/dev/null
	rmdir "$GADGET_DIR"/functions/ecm.usb0 2>/dev/null
	rmdir "$GADGET_DIR"/configs/c.1/strings/0x409 2>/dev/null
	rmdir "$GADGET_DIR"/configs/c.1 2>/dev/null
	rmdir "$GADGET_DIR"/strings/0x409 2>/dev/null
	rmdir "$GADGET_DIR" 2>/dev/null
}

start() {
	echo "Setting up iOS keyboard + pointer routing experiment..."

	USB_MODE=$(cat "$USB_MODE_PATH" 2>/dev/null)
	if [ "$USB_MODE" != "peripheral" ]; then
		echo "USB not in peripheral mode ($USB_MODE), skip"
		return
	fi

	for i in $(seq 1 30); do
		UDC=$(ls /sys/class/udc/ 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then
		echo "No UDC found"
		return
	fi

	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	modprobe dwc2 2>/dev/null
	modprobe libcomposite 2>/dev/null
	modprobe usb_f_hid 2>/dev/null
	sleep 1

	cleanup_gadget

	mkdir -p "$GADGET_DIR"
	echo 0x1d6b > "$GADGET_DIR/idVendor"
	echo 0x0104 > "$GADGET_DIR/idProduct"
	echo 0x0101 > "$GADGET_DIR/bcdDevice"
	echo 0x0200 > "$GADGET_DIR/bcdUSB"
	echo full-speed > "$GADGET_DIR/max_speed"

	# Use per-interface class identification, matching the E11 control profile.
	echo 0x00 > "$GADGET_DIR/bDeviceClass"
	echo 0x00 > "$GADGET_DIR/bDeviceSubClass"
	echo 0x00 > "$GADGET_DIR/bDeviceProtocol"

	mkdir -p "$GADGET_DIR/strings/0x409"
	echo "AIDENKEYPTRTEST01" > "$GADGET_DIR/strings/0x409/serialnumber"
	echo "Aiden" > "$GADGET_DIR/strings/0x409/manufacturer"
	echo "Aiden Keyboard Pointer Test" > "$GADGET_DIR/strings/0x409/product"

	mkdir -p "$GADGET_DIR/configs/c.1/strings/0x409"
	echo "HID Keyboard + Pointer Control" > "$GADGET_DIR/configs/c.1/strings/0x409/configuration"
	echo 500 > "$GADGET_DIR/configs/c.1/MaxPower"

	# Standard 8-byte USB boot keyboard report:
	# [modifier, reserved, key1, key2, key3, key4, key5, key6].
	mkdir -p "$GADGET_DIR/functions/hid.usb0"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/protocol"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/subclass"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/no_out_endpoint"
	echo 8 > "$GADGET_DIR/functions/hid.usb0/report_length"
	printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x01\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' \
		> "$GADGET_DIR/functions/hid.usb0/report_desc"

	# Six-byte absolute mouse report: buttons, X, Y, and wheel. Merely exposing
	# this pointer service is the variable under test; no pointer report needs to
	# be sent before the first modifier-routing check.
	mkdir -p "$GADGET_DIR/functions/hid.usb1"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/subclass"
	echo 1 > "$GADGET_DIR/functions/hid.usb1/no_out_endpoint"
	echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
	printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x08\x15\x00\x25\x01\x95\x08\x75\x01\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x01\x81\x06\xc0\xc0' \
		> "$GADGET_DIR/functions/hid.usb1/report_desc"

	# Link keyboard first so it remains interface 0, then pointer as interface 1.
	ln -s "$GADGET_DIR/functions/hid.usb0" "$GADGET_DIR/configs/c.1/hid.usb0"
	ln -s "$GADGET_DIR/functions/hid.usb1" "$GADGET_DIR/configs/c.1/hid.usb1"

	# Give configfs and both HID functions one quiet second, then bind once.
	sleep 1
	echo "$UDC" > "$GADGET_DIR/UDC"

	echo "Keyboard + pointer experiment ready: /dev/hidg0 keyboard, /dev/hidg1 pointer; no hidg2 or ECM"
}

stop() {
	cleanup_gadget
}

restart() {
	echo "USB HID hot restart is unsafe; power-cycle and reconnect to apply changes." >&2
	exit 1
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) restart ;;
  *) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
