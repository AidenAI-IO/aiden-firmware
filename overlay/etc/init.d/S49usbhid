#!/bin/sh
#
# Apple Magic Keyboard compatibility POC + Aiden pointer/media + CDC ECM.
# ECM brings up usb0 at 192.168.42.1/24 so the device serves the config portal
# to a phone/PC over USB while WiFi handles the data plane.
#

GADGET_DIR=/sys/kernel/config/usb_gadget/aiden_hid
USB_MODE_PATH=/proc/device-tree/usbdrd/usb@ffb00000/dr_mode
AGENT_TOML=/userdata/agent/agent.toml

USB0_ADDR=192.168.42.1
USB0_NETMASK=255.255.255.0
# Locally-administered MACs (0x02 bit set, not multicast).
ECM_HOST_MAC=02:aa:bb:cc:dd:01
ECM_DEV_MAC=02:aa:bb:cc:dd:02

read_pointer_mode() {
	POINTER_MODE=absolute
	if [ ! -f "$AGENT_TOML" ]; then
		return
	fi
	line=$(grep -E '^[[:space:]]*pointer_mode[[:space:]]*=' "$AGENT_TOML" | tail -n1)
	case "$line" in
		*\"touchscreen\"*|*\'touchscreen\'*|*touchscreen*) POINTER_MODE=touchscreen ;;
		*\"absolute\"*|*\'absolute\'*|*absolute*) POINTER_MODE=absolute ;;
	esac
}

reenumerate_composite() {
	# iOS can retain a stale external-keyboard session when the phone is already
	# attached during boot. Force a clean host-visible reconnect after the final
	# HID descriptors are bound.
	echo "Re-enumerating Aiden USB composite gadget..."
	echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	sleep 1
	echo "$UDC" > "$GADGET_DIR/UDC"
}

start() {
	echo "Setting up Aiden USB composite gadget (HID + ECM)..."

	USB_MODE=$(cat "$USB_MODE_PATH" 2>/dev/null)
	if [ "$USB_MODE" != "peripheral" ]; then
		echo "USB not in peripheral mode ($USB_MODE), skip"
		return
	fi

	for i in $(seq 1 30); do
		UDC=$(ls /sys/class/udc/ 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then
		echo "No UDC found"
		return
	fi

	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	modprobe dwc2 2>/dev/null
	modprobe libcomposite 2>/dev/null
	modprobe usb_f_hid 2>/dev/null
	modprobe usb_f_ecm 2>/dev/null
	sleep 1

	# Clean up stale instance
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/hid.* 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/ecm.* 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb1 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb2 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb3 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb4 2>/dev/null
		rmdir "$GADGET_DIR"/functions/ecm.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1 2>/dev/null
		rmdir "$GADGET_DIR"/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR" 2>/dev/null
	fi

	# Create gadget
	mkdir -p "$GADGET_DIR"
	# Internal compatibility experiment: use the USB identity and HID report
	# topology observed from an Apple Magic Keyboard (05ac:0267). This is not a
	# production USB identity; it exists only to determine whether iOS's
	# AppleUSBTopCaseHIDDriver repairs per-scene key-command registration more
	# reliably than the generic HID driver.
	echo 0x05ac > "$GADGET_DIR/idVendor"
	echo 0x0267 > "$GADGET_DIR/idProduct"
	echo 0x0870 > "$GADGET_DIR/bcdDevice"
	echo 0x0200 > "$GADGET_DIR/bcdUSB"

	# IAD-based multi-function device
	echo 0xEF > "$GADGET_DIR/bDeviceClass"
	echo 0x02 > "$GADGET_DIR/bDeviceSubClass"
	echo 0x01 > "$GADGET_DIR/bDeviceProtocol"

	mkdir -p "$GADGET_DIR/strings/0x409"
	echo "AIDENAPPLEPOC0001" > "$GADGET_DIR/strings/0x409/serialnumber"
	echo "Apple Inc." > "$GADGET_DIR/strings/0x409/manufacturer"
	echo "Magic Keyboard" > "$GADGET_DIR/strings/0x409/product"

	mkdir -p "$GADGET_DIR/configs/c.1/strings/0x409"
	echo "Magic Keyboard + Aiden HID + ECM POC" > "$GADGET_DIR/configs/c.1/strings/0x409/configuration"
	echo 500 > "$GADGET_DIR/configs/c.1/MaxPower"

	# Magic Keyboard interface. The descriptor is the 05ac:0267 keyboard and
	# consumer-control descriptor captured from iOS. Report ID 1 uses a 10-byte
	# input report: [0x01, modifier, reserved, key1..key6, vendor/consumer bits].
	# Report ID 0x3f is the largest report (65 bytes including the report ID), so
	# report_length must cover it even though normal key events are only 10 bytes.
	mkdir -p "$GADGET_DIR/functions/hid.usb0"
	echo 0 > "$GADGET_DIR/functions/hid.usb0/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb0/subclass"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/no_out_endpoint"
	echo 65 > "$GADGET_DIR/functions/hid.usb0/report_length"
	printf '\x05\x01\x09\x06\xa1\x01\x85\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x01\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x01\x95\x06\x75\x08\x15\x00\x26\xff\x00\x05\x07\x19\x00\x29\xff\x81\x00\x05\x0c\x75\x01\x95\x01\x09\xb8\x15\x00\x25\x01\x81\x02\x05\xff\x09\x03\x75\x07\x95\x01\x81\x02\xc0\x05\x0c\x09\x01\xa1\x01\x85\x52\x15\x00\x25\x01\x75\x01\x95\x01\x09\xcd\x81\x02\x09\xb3\x81\x02\x09\xb4\x81\x02\x09\xb5\x81\x02\x09\xb6\x81\x02\x81\x01\x81\x01\x81\x01\x85\x09\x15\x00\x25\x01\x75\x08\x95\x01\x06\x01\xff\x09\x0b\xb1\x02\x75\x08\x95\x02\xb1\x01\xc0\x06\x00\xff\x09\x06\xa1\x01\x06\x00\xff\x09\x06\x15\x00\x26\xff\x00\x75\x08\x95\x40\x85\x3f\x81\x22\xc0' \
		> "$GADGET_DIR/functions/hid.usb0/report_desc"

	# Touch / mouse HID function (report format follows agent.toml pointer_mode)
	mkdir -p "$GADGET_DIR/functions/hid.usb1"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/subclass"
	read_pointer_mode
	if [ "$POINTER_MODE" = "touchscreen" ]; then
		echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
		printf '\x05\x0d\x09\x04\xa1\x01\x09\x22\xa1\x02\x05\x0d\x09\x42\x09\x32\x15\x00\x25\x01\x75\x01\x95\x02\x81\x02\x75\x06\x95\x01\x81\x03\x09\x51\x75\x08\x95\x01\x15\x00\x25\x0f\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\xc0\xc0' \
			> "$GADGET_DIR/functions/hid.usb1/report_desc"
	else
		echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
		printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x08\x15\x00\x25\x01\x95\x08\x75\x01\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x01\x81\x06\xc0\xc0' \
			> "$GADGET_DIR/functions/hid.usb1/report_desc"
	fi

	# The real 05ac:0267 exposes two vendor-defined HID interfaces before its
	# keyboard interface. Create them after hid.usb0-1. The board kernel supports at most four HID gadget
	# instances, so this iOS experiment keeps the keyboard and pointer but omits
	# Aiden's separate media-key function. Creating the Apple functions after
	# hid.usb0-1 keeps /dev/hidg0 as keyboard and /dev/hidg1 as pointer; linking
	# them first below preserves the real keyboard's interface order.
	mkdir -p "$GADGET_DIR/functions/hid.usb3"
	echo 0 > "$GADGET_DIR/functions/hid.usb3/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb3/subclass"
	echo 1 > "$GADGET_DIR/functions/hid.usb3/no_out_endpoint"
	echo 109 > "$GADGET_DIR/functions/hid.usb3/report_length"
	printf '\x06\x00\xff\x09\x03\xa1\x01\x06\x00\xff\x09\x03\x15\x00\x26\xff\x00\x85\xc0\x96\x6b\x00\x75\x08\x81\x02\xc0' \
		> "$GADGET_DIR/functions/hid.usb3/report_desc"

	mkdir -p "$GADGET_DIR/functions/hid.usb4"
	echo 0 > "$GADGET_DIR/functions/hid.usb4/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb4/subclass"
	echo 1 > "$GADGET_DIR/functions/hid.usb4/no_out_endpoint"
	echo 5 > "$GADGET_DIR/functions/hid.usb4/report_length"
	printf '\x06\x00\xff\x09\x0b\xa1\x01\x06\x00\xff\x09\x0b\x15\x00\x26\xff\x00\x75\x08\x96\x04\x00\x85\xe0\x81\x22\x09\x0b\x96\x01\x00\x85\x9a\x81\x22\xc0\x06\x00\xff\x09\x14\xa1\x01\x85\x90\x05\x84\x75\x01\x95\x03\x15\x00\x25\x01\x09\x61\x05\x85\x09\x44\x09\x46\x81\x02\x95\x05\x81\x01\x75\x08\x95\x01\x15\x00\x26\xff\x00\x09\x65\x81\x02\xc0' \
		> "$GADGET_DIR/functions/hid.usb4/report_desc"

	# CDC ECM function (usb0 network interface)
	mkdir -p "$GADGET_DIR/functions/ecm.usb0"
	echo "$ECM_HOST_MAC" > "$GADGET_DIR/functions/ecm.usb0/host_addr"
	echo "$ECM_DEV_MAC"  > "$GADGET_DIR/functions/ecm.usb0/dev_addr"

	# Link all functions, THEN bind UDC (configfs requires this order)
	ln -s "$GADGET_DIR/functions/hid.usb3" "$GADGET_DIR/configs/c.1/hid.usb3" 2>/dev/null
	ln -s "$GADGET_DIR/functions/hid.usb4" "$GADGET_DIR/configs/c.1/hid.usb4" 2>/dev/null
	ln -s "$GADGET_DIR/functions/hid.usb0" "$GADGET_DIR/configs/c.1/hid.usb0" 2>/dev/null
	ln -s "$GADGET_DIR/functions/hid.usb1" "$GADGET_DIR/configs/c.1/hid.usb1" 2>/dev/null
	ln -s "$GADGET_DIR/functions/ecm.usb0" "$GADGET_DIR/configs/c.1/ecm.usb0" 2>/dev/null

	echo "$UDC" > "$GADGET_DIR/UDC"
	sleep 1
	reenumerate_composite

	# Bring up usb0 with a static address once the kernel netdev appears.
	for i in $(seq 1 20); do
		[ -d /sys/class/net/usb0 ] && break
		sleep 1
	done
	if [ -d /sys/class/net/usb0 ]; then
		if ifconfig usb0 "$USB0_ADDR" netmask "$USB0_NETMASK" up; then
			echo "usb0 up at $USB0_ADDR/$USB0_NETMASK"
		else
			echo "usb0 ifconfig failed"
		fi
	else
		echo "usb0 did not appear; ECM may not be bound"
	fi

	echo "Magic Keyboard POC ready: /dev/hidg0 (keyboard) /dev/hidg1 (pointer:$POINTER_MODE) /dev/hidg2-3 (Apple vendor HID) usb0 (ECM)"
}

stop() {
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	fi
	if [ -d /sys/class/net/usb0 ]; then
		ifconfig usb0 down 2>/dev/null || true
	fi
}

restart() {
	echo "USB HID hot restart is unsafe; use poweroff and reconnect power to apply changes." >&2
	exit 1
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) restart ;;
  *) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
