#!/bin/sh
#
# Aiden USB composite gadget: HID (keyboard + touch) + CDC ECM (usb0).
# ECM brings up usb0 at 192.168.42.1/24 so the device serves the config portal
# to a phone/PC over USB while WiFi handles the data plane.
#

GADGET_DIR=/sys/kernel/config/usb_gadget/aiden_hid
USB_MODE_PATH=/proc/device-tree/usbdrd/usb@ffb00000/dr_mode

USB0_ADDR=192.168.42.1
USB0_NETMASK=255.255.255.0
# Locally-administered MACs (0x02 bit set, not multicast).
ECM_HOST_MAC=02:aa:bb:cc:dd:01
ECM_DEV_MAC=02:aa:bb:cc:dd:02

start() {
	echo "Setting up Aiden USB composite gadget (HID + ECM)..."

	USB_MODE=$(cat "$USB_MODE_PATH" 2>/dev/null)
	if [ "$USB_MODE" != "peripheral" ]; then
		echo "USB not in peripheral mode ($USB_MODE), skip"
		return
	fi

	for i in $(seq 1 30); do
		UDC=$(ls /sys/class/udc/ 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then
		echo "No UDC found"
		return
	fi

	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	modprobe dwc2 2>/dev/null
	modprobe libcomposite 2>/dev/null
	modprobe usb_f_hid 2>/dev/null
	modprobe usb_f_ecm 2>/dev/null
	sleep 1

	# Clean up stale instance
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/hid.* 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/ecm.* 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb1 2>/dev/null
		rmdir "$GADGET_DIR"/functions/ecm.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1 2>/dev/null
		rmdir "$GADGET_DIR"/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR" 2>/dev/null
	fi

	# Create gadget
	mkdir -p "$GADGET_DIR"
	echo 0x1d6b > "$GADGET_DIR/idVendor"
	echo 0x0104 > "$GADGET_DIR/idProduct"
	echo 0x0100 > "$GADGET_DIR/bcdDevice"
	echo 0x0200 > "$GADGET_DIR/bcdUSB"

	# IAD-based multi-function device
	echo 0xEF > "$GADGET_DIR/bDeviceClass"
	echo 0x02 > "$GADGET_DIR/bDeviceSubClass"
	echo 0x01 > "$GADGET_DIR/bDeviceProtocol"

	mkdir -p "$GADGET_DIR/strings/0x409"
	echo "0123456789ABCDEF" > "$GADGET_DIR/strings/0x409/serialnumber"
	echo "Aiden" > "$GADGET_DIR/strings/0x409/manufacturer"
	echo "Aiden HID+ECM" > "$GADGET_DIR/strings/0x409/product"

	mkdir -p "$GADGET_DIR/configs/c.1/strings/0x409"
	echo "HID + ECM Composite" > "$GADGET_DIR/configs/c.1/strings/0x409/configuration"
	echo 500 > "$GADGET_DIR/configs/c.1/MaxPower"

	# Keyboard HID function (8-byte boot keyboard report)
	mkdir -p "$GADGET_DIR/functions/hid.usb0"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/protocol"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/subclass"
	echo 8 > "$GADGET_DIR/functions/hid.usb0/report_length"
	printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x01\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' \
		> "$GADGET_DIR/functions/hid.usb0/report_desc"

	# Touch / Absolute Mouse HID function (6-byte report)
	mkdir -p "$GADGET_DIR/functions/hid.usb1"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/subclass"
	echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
	printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x08\x15\x00\x25\x01\x95\x08\x75\x01\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x01\x81\x06\xc0\xc0' \
		> "$GADGET_DIR/functions/hid.usb1/report_desc"

	# CDC ECM function (usb0 network interface)
	mkdir -p "$GADGET_DIR/functions/ecm.usb0"
	echo "$ECM_HOST_MAC" > "$GADGET_DIR/functions/ecm.usb0/host_addr"
	echo "$ECM_DEV_MAC"  > "$GADGET_DIR/functions/ecm.usb0/dev_addr"

	# Link all functions, THEN bind UDC (configfs requires this order)
	ln -s "$GADGET_DIR/functions/hid.usb0" "$GADGET_DIR/configs/c.1/hid.usb0" 2>/dev/null
	ln -s "$GADGET_DIR/functions/hid.usb1" "$GADGET_DIR/configs/c.1/hid.usb1" 2>/dev/null
	ln -s "$GADGET_DIR/functions/ecm.usb0" "$GADGET_DIR/configs/c.1/ecm.usb0" 2>/dev/null

	echo "$UDC" > "$GADGET_DIR/UDC"

	# Bring up usb0 with a static address once the kernel netdev appears.
	for i in $(seq 1 20); do
		[ -d /sys/class/net/usb0 ] && break
		sleep 1
	done
	if [ -d /sys/class/net/usb0 ]; then
		if ifconfig usb0 "$USB0_ADDR" netmask "$USB0_NETMASK" up; then
			echo "usb0 up at $USB0_ADDR/$USB0_NETMASK"
		else
			echo "usb0 ifconfig failed"
		fi
	else
		echo "usb0 did not appear; ECM may not be bound"
	fi

	echo "Aiden USB composite ready: /dev/hidg0 (keyboard) /dev/hidg1 (touch) usb0 (ECM)"
}

stop() {
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	fi
	if [ -d /sys/class/net/usb0 ]; then
		ifconfig usb0 down 2>/dev/null || true
	fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) stop; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
