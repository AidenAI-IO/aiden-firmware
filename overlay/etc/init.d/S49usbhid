#!/bin/sh
#
# Aiden USB composite gadget: HID (keyboard + touch) + CDC ECM (usb0).
# ECM brings up usb0 at 192.168.42.1/24 so the device serves the config portal
# to a phone/PC over USB while WiFi handles the data plane.
#

GADGET_DIR=/sys/kernel/config/usb_gadget/aiden_hid
USB_MODE_PATH=/proc/device-tree/usbdrd/usb@ffb00000/dr_mode
AGENT_TOML=/userdata/agent/agent.toml
DYNAMIC_KEYBOARD_CONF=/etc/aiden_dynamic_keyboard.conf

USB0_ADDR=192.168.42.1
USB0_NETMASK=255.255.255.0
# Locally-administered MACs (0x02 bit set, not multicast).
ECM_HOST_MAC=02:aa:bb:cc:dd:01
ECM_DEV_MAC=02:aa:bb:cc:dd:02

read_pointer_mode() {
	POINTER_MODE=absolute
	if [ ! -f "$AGENT_TOML" ]; then
		return
	fi
	line=$(grep -E '^[[:space:]]*pointer_mode[[:space:]]*=' "$AGENT_TOML" | tail -n1)
	case "$line" in
		*\"touchscreen\"*|*\'touchscreen\'*|*touchscreen*) POINTER_MODE=touchscreen ;;
		*\"absolute\"*|*\'absolute\'*|*absolute*) POINTER_MODE=absolute ;;
	esac
}

read_dynamic_keyboard_mode() {
	DYNAMIC_KEYBOARD=0
	if [ ! -f "$AGENT_TOML" ]; then
		return
	fi
	line=$(grep -E '^[[:space:]]*dynamic_keyboard[[:space:]]*=' "$AGENT_TOML" | tail -n1)
	case "$line" in
		*=*[Tt][Rr][Uu][Ee]*|*=*1*) DYNAMIC_KEYBOARD=1 ;;
	esac
}

write_dynamic_keyboard_state() {
	[ -n "${DYNAMIC_KEYBOARD_STATE_FILE:-}" ] || return
	{
		echo "mode=off"
		echo "result=initialized"
		echo "duration_ms=0"
		echo "updated_epoch=$(date +%s)"
		echo "udc=$(cat "$GADGET_DIR/UDC" 2>/dev/null || true)"
		echo "udc_state=$(cat /sys/class/udc/*/state 2>/dev/null | head -n1 || true)"
	} > "$DYNAMIC_KEYBOARD_STATE_FILE"
}

reenumerate_composite() {
	# iOS can retain a stale external-keyboard session when the phone is already
	# attached during boot. Force a clean host-visible reconnect after the final
	# HID descriptors are bound.
	echo "Re-enumerating Aiden USB composite gadget..."
	echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	sleep 1
	echo "$UDC" > "$GADGET_DIR/UDC"
}

start() {
	echo "Setting up Aiden USB composite gadget (HID + ECM)..."

	USB_MODE=$(cat "$USB_MODE_PATH" 2>/dev/null)
	if [ "$USB_MODE" != "peripheral" ]; then
		echo "USB not in peripheral mode ($USB_MODE), skip"
		return
	fi

	for i in $(seq 1 30); do
		UDC=$(ls /sys/class/udc/ 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then
		echo "No UDC found"
		return
	fi

	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	modprobe dwc2 2>/dev/null
	modprobe libcomposite 2>/dev/null
	modprobe usb_f_hid 2>/dev/null
	modprobe usb_f_ecm 2>/dev/null
	sleep 1

	read_pointer_mode
	read_dynamic_keyboard_mode
	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		if [ ! -f "$DYNAMIC_KEYBOARD_CONF" ]; then
			echo "Dynamic keyboard config missing: $DYNAMIC_KEYBOARD_CONF"
			return 1
		fi
		. "$DYNAMIC_KEYBOARD_CONF"
	fi

	# Clean up stale instance
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/hid.* 2>/dev/null
		rm -f "$GADGET_DIR"/configs/c.1/ecm.* 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb1 2>/dev/null
		rmdir "$GADGET_DIR"/functions/hid.usb2 2>/dev/null
		rmdir "$GADGET_DIR"/functions/ecm.usb0 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR"/configs/c.1 2>/dev/null
		rmdir "$GADGET_DIR"/strings/0x409 2>/dev/null
		rmdir "$GADGET_DIR" 2>/dev/null
	fi

	# Create gadget
	mkdir -p "$GADGET_DIR"
	echo 0x1d6b > "$GADGET_DIR/idVendor"
	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		echo "$DYNAMIC_KEYBOARD_OFF_ID_PRODUCT" > "$GADGET_DIR/idProduct"
		echo "$DYNAMIC_KEYBOARD_OFF_BCD_DEVICE" > "$GADGET_DIR/bcdDevice"
	else
		echo 0x0104 > "$GADGET_DIR/idProduct"
		echo 0x0100 > "$GADGET_DIR/bcdDevice"
	fi
	echo 0x0200 > "$GADGET_DIR/bcdUSB"

	# IAD-based multi-function device
	echo 0xEF > "$GADGET_DIR/bDeviceClass"
	echo 0x02 > "$GADGET_DIR/bDeviceSubClass"
	echo 0x01 > "$GADGET_DIR/bDeviceProtocol"

	mkdir -p "$GADGET_DIR/strings/0x409"
	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		echo "$DYNAMIC_KEYBOARD_OFF_SERIAL" > "$GADGET_DIR/strings/0x409/serialnumber"
	else
		echo "0123456789ABCDEF" > "$GADGET_DIR/strings/0x409/serialnumber"
	fi
	echo "Aiden" > "$GADGET_DIR/strings/0x409/manufacturer"
	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		echo "$DYNAMIC_KEYBOARD_OFF_PRODUCT" > "$GADGET_DIR/strings/0x409/product"
	else
		echo "Aiden HID+ECM" > "$GADGET_DIR/strings/0x409/product"
	fi

	mkdir -p "$GADGET_DIR/configs/c.1/strings/0x409"
	echo "HID + ECM Composite" > "$GADGET_DIR/configs/c.1/strings/0x409/configuration"
	echo 500 > "$GADGET_DIR/configs/c.1/MaxPower"

	# Keyboard HID function (8-byte boot keyboard report).
	# Keep the boot subclass/protocol for broad host compatibility. iOS modifier
	# failures are caused by stale host-side HID sessions; force a clean
	# re-enumeration after binding instead of changing the advertised protocol.
	mkdir -p "$GADGET_DIR/functions/hid.usb0"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/protocol"
	echo 1 > "$GADGET_DIR/functions/hid.usb0/subclass"
	echo 8 > "$GADGET_DIR/functions/hid.usb0/report_length"
	printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x01\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' \
		> "$GADGET_DIR/functions/hid.usb0/report_desc"

	# Touch / mouse HID function (report format follows agent.toml pointer_mode)
	mkdir -p "$GADGET_DIR/functions/hid.usb1"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb1/subclass"
	if [ "$POINTER_MODE" = "touchscreen" ]; then
		echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
		printf '\x05\x0d\x09\x04\xa1\x01\x09\x22\xa1\x02\x05\x0d\x09\x42\x09\x32\x15\x00\x25\x01\x75\x01\x95\x02\x81\x02\x75\x06\x95\x01\x81\x03\x09\x51\x75\x08\x95\x01\x15\x00\x25\x0f\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\xc0\xc0' \
			> "$GADGET_DIR/functions/hid.usb1/report_desc"
	else
		echo 6 > "$GADGET_DIR/functions/hid.usb1/report_length"
		printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x08\x15\x00\x25\x01\x95\x08\x75\x01\x81\x02\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x01\x81\x06\xc0\xc0' \
			> "$GADGET_DIR/functions/hid.usb1/report_desc"
	fi

	mkdir -p "$GADGET_DIR/functions/hid.usb2"
	echo 0 > "$GADGET_DIR/functions/hid.usb2/protocol"
	echo 0 > "$GADGET_DIR/functions/hid.usb2/subclass"
	echo 2 > "$GADGET_DIR/functions/hid.usb2/report_length"
	if [ "$POINTER_MODE" = "touchscreen" ]; then
		printf '\x05\x0c\x09\x01\xa1\x01\x15\x00\x26\xff\x03\x1a\x00\x00\x2a\xff\x03\x75\x10\x95\x01\x81\x00\xc0' \
			> "$GADGET_DIR/functions/hid.usb2/report_desc"
	else
		printf '\x05\x0c\x09\x01\xa1\x01\x15\x00\x25\x01\x09\xe2\x09\xe9\x09\xea\x09\xcd\x09\xb7\x09\xb5\x09\xb6\x09\xb4\x09\xb3\x09\x65\x09\x6f\x09\x70\x75\x01\x95\x0c\x81\x02\x75\x01\x95\x04\x81\x03\xc0' \
			> "$GADGET_DIR/functions/hid.usb2/report_desc"
	fi

	# CDC ECM function (usb0 network interface)
	mkdir -p "$GADGET_DIR/functions/ecm.usb0"
	echo "$ECM_HOST_MAC" > "$GADGET_DIR/functions/ecm.usb0/host_addr"
	echo "$ECM_DEV_MAC"  > "$GADGET_DIR/functions/ecm.usb0/dev_addr"

	# Dynamic mode boots without a keyboard. The function instance still exists
	# and reserves /dev/hidg0, but only linked functions enter USB descriptors.
	if [ "$DYNAMIC_KEYBOARD" -ne 1 ]; then
		ln -s "$GADGET_DIR/functions/hid.usb0" "$GADGET_DIR/configs/c.1/hid.usb0" 2>/dev/null
	fi
	ln -s "$GADGET_DIR/functions/hid.usb1" "$GADGET_DIR/configs/c.1/hid.usb1" 2>/dev/null
	if [ "$DYNAMIC_KEYBOARD" -ne 1 ]; then
		ln -s "$GADGET_DIR/functions/hid.usb2" "$GADGET_DIR/configs/c.1/hid.usb2" 2>/dev/null
	fi
	ln -s "$GADGET_DIR/functions/ecm.usb0" "$GADGET_DIR/configs/c.1/ecm.usb0" 2>/dev/null

	echo "$UDC" > "$GADGET_DIR/UDC"
	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		write_dynamic_keyboard_state
	else
		sleep 1
		reenumerate_composite
	fi

	# Bring up usb0 with a static address once the kernel netdev appears.
	for i in $(seq 1 20); do
		[ -d /sys/class/net/usb0 ] && break
		sleep 1
	done
	if [ -d /sys/class/net/usb0 ]; then
		if ifconfig usb0 "$USB0_ADDR" netmask "$USB0_NETMASK" up; then
			echo "usb0 up at $USB0_ADDR/$USB0_NETMASK"
		else
			echo "usb0 ifconfig failed"
		fi
	else
		echo "usb0 did not appear; ECM may not be bound"
	fi

	if [ "$DYNAMIC_KEYBOARD" -eq 1 ]; then
		echo "Aiden dynamic keyboard ready: keyboard=off /dev/hidg1 (pointer:$POINTER_MODE) usb0 (ECM)"
	elif [ "$POINTER_MODE" = "touchscreen" ]; then
		echo "Aiden USB composite ready: /dev/hidg0 (keyboard) /dev/hidg1 (pointer:$POINTER_MODE) /dev/hidg2 (android-extension) usb0 (ECM)"
	else
		echo "Aiden USB composite ready: /dev/hidg0 (keyboard) /dev/hidg1 (pointer:$POINTER_MODE) /dev/hidg2 (media-keys) usb0 (ECM)"
	fi
}

stop() {
	if [ -d "$GADGET_DIR" ]; then
		echo "" > "$GADGET_DIR/UDC" 2>/dev/null
	fi
	if [ -d /sys/class/net/usb0 ]; then
		ifconfig usb0 down 2>/dev/null || true
	fi
}

restart() {
	echo "USB HID hot restart is unsafe; use poweroff and reconnect power to apply changes." >&2
	exit 1
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) restart ;;
  *) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
