#!/bin/sh
# Aiden Go agent daemon.
# Provides HTTP API and web UI for agent interactions.

AGENT_BIN=/oem/usr/bin/agent
ENV_RUN_BIN=${ENV_RUN_BIN:-/oem/usr/bin/aiden-env-run}
CONFIG_DIR=${CONFIG_DIR:-/userdata/agent}
ADDR=0.0.0.0:8080
STORAGE_LEVEL_PATH=${STORAGE_LEVEL_PATH:-/run/agent/storage_level}
PID_FILE=/run/agent/agent.pid
WATCHDOG_PID_FILE=/run/agent/agent_watchdog.pid
BOOT_CONF=/etc/aiden_boot.conf
AIDEN_LOG_HELPER=${AIDEN_LOG_HELPER:-/oem/usr/lib/aiden-log.sh}
[ -r "$AIDEN_LOG_HELPER" ] || AIDEN_LOG_HELPER="$(dirname "$0")/../../oem/usr/lib/aiden-log.sh"
. "$AIDEN_LOG_HELPER"

if [ -f "$BOOT_CONF" ]; then
    . "$BOOT_CONF"
fi
: "${ENABLE_AGENT:=1}"
LOG_PATH=${LOG_PATH:-$CONFIG_DIR/log/agent.log}

supervisor_log() {
    level="$1"
    event="$2"
    shift 2
    aiden_log_to_file "$LOG_PATH" "$level" agent supervisor "$event" "$*"
}

configured_agent_log_max_mb() {
    config_path="$CONFIG_DIR/agent.toml"
    [ -r "$config_path" ] || return 0
    awk '
        /^\[storage\.degraded_mode\][[:space:]]*$/ { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && $1 == "max_agent_log_mb" && $2 == "=" { print $3; exit }
    ' "$config_path"
}

agent_log_max_bytes() {
    if [ -n "${AGENT_LOG_MAX_BYTES:-}" ]; then
        bytes="$AGENT_LOG_MAX_BYTES"
    else
        max_mb="${AGENT_LOG_MAX_MB:-$(configured_agent_log_max_mb)}"
        case "$max_mb" in
            ''|*[!0-9]*|0) max_mb=1 ;;
        esac
        bytes="$((max_mb * 1024 * 1024))"
    fi
    case "$bytes" in
        ''|*[!0-9]*|0) bytes=$((1024 * 1024)) ;;
    esac
    echo "$bytes"
}

trim_agent_log() {
    [ -f "$LOG_PATH" ] || return 0
    level="$(cat "$STORAGE_LEVEL_PATH" 2>/dev/null || true)"
    case "$level" in
        critical|emergency) ;;
        *) return 0 ;;
    esac
    max_bytes="$(agent_log_max_bytes)"
    size="$(wc -c < "$LOG_PATH" | tr -d ' ')"
    [ "$size" -gt "$max_bytes" ] || return 0

    trim_path="${LOG_PATH}.trim.$$"
    if tail -c "$max_bytes" "$LOG_PATH" > "$trim_path"; then
        cat "$trim_path" > "$LOG_PATH"
    fi
    rm -f "$trim_path"
}

is_running() {
    pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

pid_matches_service() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$AGENT_BIN"*) return 0 ;;
        *"agent"*"-dir"*"$CONFIG_DIR"*) return 0 ;;
        *) return 1 ;;
    esac
}

pid_matches_watchdog() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$0"*|*"S53agent"*) return 0 ;;
        *) return 1 ;;
    esac
}

service_pid() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_service "$pid"; then
            echo "$pid"
        fi
    fi
}

watchdog_pid() {
    if [ -f "$WATCHDOG_PID_FILE" ]; then
        pid="$(cat "$WATCHDOG_PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_watchdog "$pid"; then
            echo "$pid"
        fi
    fi
}

start() {
    if [ "$ENABLE_AGENT" != "1" ]; then
        echo "agent disabled by config (ENABLE_AGENT=$ENABLE_AGENT)"
        return 0
    fi

    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        echo "agent watchdog already running (pid $wpid)"
        return 0
    fi

    mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_PATH")" "$CONFIG_DIR"
    chmod 0755 "$(dirname "$PID_FILE")" "$(dirname "$LOG_PATH")"

    (
        trap '' HUP
        trap 'exit 0' INT TERM
        while true; do
            if [ ! -x "$AGENT_BIN" ]; then
                supervisor_log WARN binary_wait "waiting for $AGENT_BIN"
                trim_agent_log
                sleep 5
                continue
            fi

            supervisor_log INFO process_starting \
                "starting $AGENT_BIN -dir $CONFIG_DIR -addr $ADDR"
            "$ENV_RUN_BIN" "$AGENT_BIN" -dir "$CONFIG_DIR" -addr "$ADDR" >> "$LOG_PATH" 2>&1 &
            child="$!"
            echo "$child" > "$PID_FILE"
            while is_running "$child"; do
                sleep 1
                trim_agent_log
            done
            wait "$child"
            status="$?"
            rm -f "$PID_FILE"
            supervisor_log WARN process_exited \
                "exited with status $status; restarting in 2s"
            trim_agent_log
            sleep 2
        done
    ) &
    echo "$!" > "$WATCHDOG_PID_FILE"
    echo "Started agent"
}

stop() {
    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        kill "$wpid" 2>/dev/null || true
    fi
    rm -f "$WATCHDOG_PID_FILE"

    spid="$(service_pid)"
    if is_running "$spid"; then
        kill "$spid" 2>/dev/null || true
        i=0
        while is_running "$spid" && [ "$i" -lt 5 ]; do
            sleep 1
            i="$((i + 1))"
        done
        if is_running "$spid"; then
            kill -9 "$spid" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE"
    echo "Stopped agent"
}

status() {
    wpid="$(watchdog_pid)"
    spid="$(service_pid)"
    echo "log_path=$LOG_PATH"
    if is_running "$wpid"; then
        echo "watchdog=running pid=$wpid"
    else
        echo "watchdog=stopped"
    fi
    if is_running "$spid"; then
        echo "agent=running pid=$spid addr=$ADDR"
    else
        echo "agent=stopped"
    fi
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        status
        ;;
    trim-log)
        trim_agent_log
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|trim-log}" >&2
        exit 1
        ;;
esac
