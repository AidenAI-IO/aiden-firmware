#!/bin/sh
# Aiden Go agent daemon.
# Provides HTTP API and web UI for agent interactions.

AGENT_BIN=/oem/usr/bin/agent
CONFIG_DIR=/userdata/agent
ADDR=:8080
LOG_PATH=/var/log/agent/agent.log
PID_FILE=/run/agent/agent.pid
WATCHDOG_PID_FILE=/run/agent/agent_watchdog.pid
BOOT_CONF=/etc/aiden_boot.conf

if [ -f "$BOOT_CONF" ]; then
    . "$BOOT_CONF"
fi
: "${ENABLE_AGENT:=1}"

is_running() {
    pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

pid_matches_service() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$AGENT_BIN"*) return 0 ;;
        *"agent"*"-config"*"$CONFIG_DIR"*) return 0 ;;
        *) return 1 ;;
    esac
}

pid_matches_watchdog() {
    pid="$1"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmd" in
        *"$0"*|*"S53agent"*) return 0 ;;
        *) return 1 ;;
    esac
}

service_pid() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_service "$pid"; then
            echo "$pid"
        fi
    fi
}

watchdog_pid() {
    if [ -f "$WATCHDOG_PID_FILE" ]; then
        pid="$(cat "$WATCHDOG_PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) return ;;
        esac
        if pid_matches_watchdog "$pid"; then
            echo "$pid"
        fi
    fi
}

start() {
    if [ "$ENABLE_AGENT" != "1" ]; then
        echo "agent disabled by config (ENABLE_AGENT=$ENABLE_AGENT)"
        return 0
    fi

    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        echo "agent watchdog already running (pid $wpid)"
        return 0
    fi

    mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_PATH")" "$CONFIG_DIR"
    chmod 0755 "$(dirname "$PID_FILE")" "$(dirname "$LOG_PATH")"

    (
        trap 'exit 0' INT TERM
        while true; do
            if [ ! -x "$AGENT_BIN" ]; then
                echo "[agent] waiting for $AGENT_BIN" >> "$LOG_PATH"
                sleep 5
                continue
            fi

            echo "[agent] starting $AGENT_BIN -config $CONFIG_DIR -addr $ADDR" >> "$LOG_PATH"
            "$AGENT_BIN" -config "$CONFIG_DIR" -addr "$ADDR" >> "$LOG_PATH" 2>&1 &
            child="$!"
            echo "$child" > "$PID_FILE"
            wait "$child"
            status="$?"
            rm -f "$PID_FILE"
            echo "[agent] exited with status $status; restarting in 2s" >> "$LOG_PATH"
            sleep 2
        done
    ) &
    echo "$!" > "$WATCHDOG_PID_FILE"
    echo "Started agent"
}

stop() {
    wpid="$(watchdog_pid)"
    if is_running "$wpid"; then
        kill "$wpid" 2>/dev/null || true
    fi
    rm -f "$WATCHDOG_PID_FILE"

    spid="$(service_pid)"
    if is_running "$spid"; then
        kill "$spid" 2>/dev/null || true
        i=0
        while is_running "$spid" && [ "$i" -lt 5 ]; do
            sleep 1
            i="$((i + 1))"
        done
        if is_running "$spid"; then
            kill -9 "$spid" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE"
    echo "Stopped agent"
}

status() {
    wpid="$(watchdog_pid)"
    spid="$(service_pid)"
    if is_running "$wpid"; then
        echo "watchdog=running pid=$wpid"
    else
        echo "watchdog=stopped"
    fi
    if is_running "$spid"; then
        echo "agent=running pid=$spid addr=$ADDR"
    else
        echo "agent=stopped"
    fi
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
