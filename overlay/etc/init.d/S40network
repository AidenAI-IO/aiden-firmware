#!/bin/sh
# Aiden override: optional baseline network interface bring-up.

BOOT_CONF=/etc/aiden_boot.conf

if [ -f "$BOOT_CONF" ]; then
	. "$BOOT_CONF"
fi
: "${ENABLE_NETWORK:=1}"

start() {
	if [ "$ENABLE_NETWORK" != "1" ]; then
		echo "network disabled by config (ENABLE_NETWORK=$ENABLE_NETWORK)"
		return 0
	fi

	ifconfig lo up 2>/dev/null || true
	ifconfig eth0 up 2>/dev/null || true
	ifconfig wlan0 up 2>/dev/null || true
	echo "Started baseline network interfaces"
}

stop() {
	ifconfig wlan0 down 2>/dev/null || true
	ifconfig eth0 down 2>/dev/null || true
	echo "Stopped baseline network interfaces"
}

restart() {
	stop
	start
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) restart ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
